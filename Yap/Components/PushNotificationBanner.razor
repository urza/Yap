@inject IJSRuntime JS
@inject PushSubscriptionStore PushStore
@inject PushNotificationService PushService
@inject UserStateService UserState
@inject ILogger<PushNotificationBanner> Logger

@if (_visible)
{
    <div class="push-notif-banner @(_hiding ? "hiding" : "")">
        <div class="push-banner-content">
            <svg class="push-banner-icon" width="36" height="36" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm6-6v-5c0-3.07-1.63-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.64 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2zm-2 1H8v-6c0-2.48 1.51-4.5 4-4.5s4 2.02 4 4.5v6z"/>
            </svg>

            <div class="push-banner-text">
                <strong>Enable Notifications</strong>
                <span>Get notified when you receive new messages, even when the app is in the background.</span>
            </div>

            <div class="push-banner-actions">
                <button class="push-enable-btn" @onclick="Enable" disabled="@_enabling">
                    @(_enabling ? "Enabling..." : "Enable")
                </button>
                <button class="push-dismiss-btn" @onclick="Dismiss">Not now</button>
            </div>
        </div>
    </div>
}

@code {
    private bool _visible;
    private bool _hiding;
    private bool _enabling;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (!PushService.IsConfigured) return;

        try
        {
            // Only show for PWA users who haven't subscribed and haven't dismissed this session
            var shouldShow = await JS.InvokeAsync<bool>("shouldShowPushBanner");
            if (!shouldShow) return;

            Logger.LogDebug("Push banner: eligible for {Username}, waiting before showing", UserState.Username);

            // Wait 15 seconds — shorter than PWA install (45s) since user is already committed to the app
            await Task.Delay(15_000);

            // Don't interrupt typing
            while (await JS.InvokeAsync<bool>("isMessageInputFocused"))
                await Task.Delay(5000);

            _visible = true;
            StateHasChanged();
            Logger.LogDebug("Push banner: shown for {Username}", UserState.Username);
        }
        catch (Exception ex) when (ex is ObjectDisposedException or InvalidOperationException)
        {
            // Circuit dead, ignore
        }
    }

    private async Task AnimateOut(Func<Task>? afterHide = null)
    {
        _hiding = true;
        StateHasChanged();
        await Task.Delay(300);
        _visible = false;
        _hiding = false;
        StateHasChanged();

        if (afterHide != null)
            await afterHide();
    }

    private async Task Enable()
    {
        _enabling = true;
        StateHasChanged();

        try
        {
            // Request permission (this is the user gesture the browser requires)
            var permission = await JS.InvokeAsync<string>("requestNotificationPermission");
            if (permission != "granted")
            {
                Logger.LogDebug("Push banner: permission {Permission} for {Username}", permission, UserState.Username);
                await AnimateOut(async () =>
                {
                    await JS.InvokeVoidAsync("dismissPushBanner");
                });
                return;
            }

            // Subscribe
            var publicKey = PushService.GetPublicKey();
            if (publicKey == null) return;

            var subscriptionJson = await JS.InvokeAsync<string?>("subscribeToPush", publicKey);
            if (subscriptionJson == null)
            {
                Logger.LogDebug("Push banner: browser subscription failed for {Username}", UserState.Username);
                await AnimateOut(async () =>
                {
                    await JS.InvokeVoidAsync("dismissPushBanner");
                });
                return;
            }

            var subData = System.Text.Json.JsonSerializer.Deserialize<PushSubData>(subscriptionJson);
            if (subData != null && UserState.Username != null)
            {
                await PushStore.SaveSubscriptionAsync(UserState.Username, new PushSubscriptionInfo
                {
                    Endpoint = subData.Endpoint ?? "",
                    P256dh = subData.P256dh ?? "",
                    Auth = subData.Auth ?? ""
                });
                Logger.LogDebug("Push banner: subscribed {Username}", UserState.Username);
            }

            await AnimateOut(async () =>
            {
                await JS.InvokeVoidAsync("dismissPushBanner");
            });
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Push banner: enable failed for {Username}", UserState.Username);
            _enabling = false;
            StateHasChanged();
        }
    }

    private async Task Dismiss()
    {
        Logger.LogDebug("Push banner: dismissed by {Username}", UserState.Username);
        await AnimateOut(async () =>
        {
            await JS.InvokeVoidAsync("dismissPushBanner");
        });
    }

    private record PushSubData(string? Endpoint, string? P256dh, string? Auth);
}

@using Yap.Models

@if (!string.IsNullOrEmpty(Preview.CachedMediaUrl))
{
    <div class="media-player-container">
        @if (Preview.MediaType == CachedMediaType.Video)
        {
            <video controls preload="auto" class="cached-video-player" style="@VideoAspectStyle">
                <source src="@Preview.CachedMediaUrl" type="video/mp4" />
            </video>
        }
        else if (Preview.MediaType == CachedMediaType.Audio)
        {
            <div class="cached-audio-player">
                @if (!string.IsNullOrEmpty(Preview.ImageUrl))
                {
                    <img src="@Preview.ImageUrl" alt="" class="audio-thumbnail" loading="lazy" />
                }
                <div class="audio-info">
                    @if (!string.IsNullOrEmpty(Preview.Title))
                    {
                        <span class="audio-title">@Preview.Title</span>
                    }
                    @if (!string.IsNullOrEmpty(Preview.SiteName))
                    {
                        <span class="audio-site">@Preview.SiteName</span>
                    }
                    <audio controls preload="metadata" class="audio-element">
                        <source src="@Preview.CachedMediaUrl" />
                    </audio>
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public LinkPreview Preview { get; set; } = default!;

    // Per-video aspect-ratio override so portrait videos (TikTok / Shorts) reserve
    // a 9:16-ish box instead of the CSS-default 16/9 fallback. Empty when unknown
    // (lets CSS fallback apply).
    private string VideoAspectStyle =>
        Preview.MediaWidth is > 0 && Preview.MediaHeight is > 0
            ? $"aspect-ratio: {Preview.MediaWidth} / {Preview.MediaHeight};"
            : "";
}

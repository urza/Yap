@inject ChatService ChatService
@inject ChatConfigService ChatConfig
@inject UserStateService UserState
@inject UserService UserService
@inject ImageService ImageService
@inject VideoService VideoService
@inject MediaUploadLogService MediaLog
@inject IJSRuntime JS
@inject IWebHostEnvironment Environment
@inject ILogger<MessageInput> Logger
@implements IAsyncDisposable

@if (ReadOnly)
{
    <div class="typing-indicator-container"></div>
    <div class="readonly-bar">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/>
        </svg>
        <span>You do not have permission to send messages in this channel</span>
    </div>
}
else
{

@if (!string.IsNullOrEmpty(warningTitle))
{
    <div class="warning-modal-backdrop" @onclick="DismissWarning">
        <div class="warning-modal" @onclick:stopPropagation="true">
            <button class="warning-modal-close" @onclick="DismissWarning">✕</button>
            <h3 class="warning-modal-title">@warningTitle</h3>
            <p class="warning-modal-message" style="white-space: pre-line;">@warningMessage</p>
            <button class="warning-modal-button" @onclick="DismissWarning">Got It</button>
        </div>
    </div>
}

<div class="typing-indicator-container">
    @if (isUploading)
    {
        <div class="typing-indicator upload-indicator">
            <span style="display: flex; align-items: center; gap: 0.5rem; color: #5865f2;">
                <span class="typing-dots">
                    <span class="dot upload-dot"></span>
                    <span class="dot upload-dot"></span>
                    <span class="dot upload-dot"></span>
                </span>
                <span>Uploading @uploadingCount file@(uploadingCount > 1 ? "s" : "")...</span>
            </span>
        </div>
    }
    else if (!string.IsNullOrEmpty(typingIndicatorText))
    {
        <div class="typing-indicator">
            <span style="display: flex; align-items: center; gap: 0.5rem; color: #72767d;">
                <span class="typing-dots">
                    <span class="dot"></span>
                    <span class="dot"></span>
                    <span class="dot"></span>
                </span>
                <span>@typingIndicatorText</span>
            </span>
        </div>
    }
</div>

@if (ReplyingToMessage != null)
{
    <div class="reply-bar">
        <span class="reply-bar-text">
            Replying to <strong>@(ReplyingToDisplayName ?? ReplyingToMessage.Username)</strong>
        </span>
        <button class="reply-bar-close" @onclick="HandleCancelReply">✕</button>
    </div>
}

<div class="message-input-container @(isDraggingOver ? "drag-over" : "") @(ReplyingToMessage != null ? "has-reply-bar" : "") @(showEmojiPicker ? "emoji-open" : "")"
     @ref="dropZoneElement"
     @ondragenter="HandleDragEnter"
     @ondragover="HandleDragOver"
     @ondragover:preventDefault
     @ondragleave="HandleDragLeave"
     @ondrop="HandleDrop"
     @ondrop:preventDefault>
    <textarea @bind="messageText" @bind:event="oninput" @bind:after="OnInputChangedInternal"
              placeholder="@placeholder" class="message-input"
              @onkeydown="HandleKeyDown"
              rows="1" id="@TextareaId"></textarea>
    <label class="image-upload-button" title="Upload files">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
            <circle cx="8.5" cy="8.5" r="1.5"></circle>
            <polyline points="21 15 16 10 5 21"></polyline>
        </svg>
        <InputFile OnChange="HandleFileSelected" accept="image/*,video/*" multiple style="display: none;" id="@FileInputId" />
    </label>
    <div class="emoji-toggle-wrapper">
        <button class="emoji-toggle-button @(showEmojiPicker ? "active" : "")" @onclick="ToggleEmojiPicker" title="Emoji picker">
            <span class="emoji-toggle-icon" id="@EmojiIconId"
                  style="--grey-col: @greyCol; --grey-row: @greyRow; --color-col: @colorCol; --color-row: @colorRow;"></span>
        </button>
        @if (showEmojiPicker)
        {
            <div class="emoji-picker-backdrop" @onclick="CloseEmojiPicker"></div>
            <div class="emoji-picker-container">
                <EmojiPicker RecentEmojis="@RecentEmojis" OnEmojiSelected="HandleEmojiSelected" />
            </div>
        }
    </div>
    <button class="send-button @(string.IsNullOrWhiteSpace(messageText) ? "disabled" : "")"
            @onclick="HandleSend"
            disabled="@string.IsNullOrWhiteSpace(messageText)"
            title="Send message">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
        </svg>
    </button>
</div>

} @* end else (not ReadOnly) *@

@code {
    // Context parameters - one or the other will be set
    [Parameter] public Guid? RoomId { get; set; }
    [Parameter] public string? DmUser { get; set; }

    // Emoji drawer parameters
    [Parameter] public List<string> RecentEmojis { get; set; } = new();
    [Parameter] public EventCallback<string> OnEmojiUsed { get; set; }

    // Read-only mode (channel write permissions)
    [Parameter] public bool ReadOnly { get; set; }

    // Reply parameters
    [Parameter] public ChatMessage? ReplyingToMessage { get; set; }
    [Parameter] public string? ReplyingToDisplayName { get; set; }
    [Parameter] public EventCallback OnCancelReply { get; set; }

    private Guid UserId => UserState.UserId ?? Guid.Empty;
    private string Username => UserState.Username ?? "";
    private bool IsRoomContext => RoomId.HasValue;
    private bool IsDmContext => !string.IsNullOrEmpty(DmUser);

    // The channel ID for the current context
    private Guid? channelId;

    // Internal state
    private ElementReference dropZoneElement;
    private bool isDraggingOver = false;
    private string messageText = "";
    private string placeholder = "";
    private string typingIndicatorText = "";
    private string warningTitle = "";
    private string warningMessage = "";
    private bool isTyping = false;
    private bool isUploading = false;
    private int uploadingCount = 0;
    // Typing timeout uses CancellationTokenSource + Task.Delay pattern:
    // - On each keystroke, cancel current delay and start new 3s delay
    // - If user stops typing for 3s, delay completes and calls StopTypingAsync
    // - This avoids threading issues with System.Timers.Timer
    private CancellationTokenSource? typingCts;

    // Unique IDs for this instance
    private string TextareaId = $"messageTextarea_{Guid.NewGuid():N}";
    private string FileInputId = $"fileInput_{Guid.NewGuid():N}";
    private bool isTouchDevice = false;
    private bool showEmojiPicker = false;

    // Emoji button sprite grid: 960x192 PNG, 48px cells = 20 cols x 4 rows
    private const int SpriteCols = 20;
    private const int SpriteTotalEmojis = 73; // 3 full rows + 13 in last row
    private static readonly Random _random = new();
    private string EmojiIconId = $"emojiIcon_{Guid.NewGuid():N}";
    private int greyCol;
    private int greyRow;
    private int colorCol;
    private int colorRow;

    protected override void OnInitialized()
    {
        var greyIndex = _random.Next(SpriteTotalEmojis);
        greyCol = greyIndex % SpriteCols;
        greyRow = greyIndex / SpriteCols;
        var colorIndex = _random.Next(SpriteTotalEmojis);
        colorCol = colorIndex % SpriteCols;
        colorRow = colorIndex / SpriteCols;

        UpdateChannelId();
        UpdatePlaceholder();

        // Subscribe to typing events (unified for all channels)
        ChatService.OnTypingUsersChanged += HandleTypingUsersChanged;

        UpdateTypingIndicator();
    }

    protected override void OnParametersSet()
    {
        UpdateChannelId();
        UpdatePlaceholder();
        UpdateTypingIndicator();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try { await JS.InvokeVoidAsync("setupDropZone", dropZoneElement, FileInputId); }
            catch (Exception ex) { Logger.LogWarning(ex, "Failed to setup drop zone"); }
            try { isTouchDevice = await JS.InvokeAsync<bool>("isTouchDevice"); }
            catch (Exception ex) { Logger.LogWarning(ex, "Failed to detect touch device"); }
            try { await JS.InvokeVoidAsync("setupEnterKeyHandler", TextareaId); }
            catch (Exception ex) { Logger.LogWarning(ex, "Failed to setup enter key handler"); }
            try { await JS.InvokeVoidAsync("setupSendButtonFocus", TextareaId); }
            catch (Exception ex) { Logger.LogWarning(ex, "Failed to setup send button focus"); }
            try { await JS.InvokeVoidAsync("setupEmojiToggle", EmojiIconId, SpriteCols, SpriteTotalEmojis); }
            catch (Exception ex) { Logger.LogWarning(ex, "Failed to setup emoji toggle"); }
            try { await JS.InvokeVoidAsync("setupPasteUpload", TextareaId, FileInputId); }
            catch (Exception ex) { Logger.LogWarning(ex, "Failed to setup paste upload"); }
        }
    }

    private void UpdateChannelId()
    {
        if (IsRoomContext)
        {
            channelId = RoomId;
        }
        else if (IsDmContext && !string.IsNullOrEmpty(DmUser))
        {
            var otherUser = UserService.GetByUsername(DmUser);
            if (otherUser != null)
            {
                var channel = ChatService.GetOrCreateDMChannel(UserId, Username, otherUser.Id, otherUser.Username);
                channelId = channel.Id;
            }
            else
            {
                channelId = null;
            }
        }
        else
        {
            channelId = null;
        }
    }

    private void UpdatePlaceholder()
    {
        if (IsDmContext)
        {
            placeholder = $"Message @{DmUser}";
        }
        else
        {
            placeholder = ChatConfig.GetRandomMessagePlaceholder();
        }
    }

    #region Typing Indicator

    private void UpdateTypingIndicator()
    {
        if (channelId.HasValue)
        {
            var typingUsers = ChatService.GetTypingUsers(channelId.Value);
            var others = typingUsers.Where(u => !u.Equals(Username, StringComparison.OrdinalIgnoreCase)).ToList();

            if (IsDmContext)
            {
                // Simple DM typing indicator
                typingIndicatorText = others.Count > 0 ? $"{string.Join(", ", others)} is typing..." : "";
            }
            else
            {
                // Room typing indicator with random messages
                typingIndicatorText = ChatConfig.GetRandomTypingIndicator(others, Username);
            }
        }
        else
        {
            typingIndicatorText = "";
        }
    }

    private async void HandleTypingUsersChanged(Guid changedChannelId)
    {
        if (channelId.HasValue && channelId.Value == changedChannelId)
        {
            try
            {
                await InvokeAsync(() =>
                {
                    UpdateTypingIndicator();
                    StateHasChanged();
                });
            }
            catch (Exception ex)
            {
                if (ex is ObjectDisposedException or InvalidOperationException)
                    Logger.LogWarning("HandleTypingUsersChanged: {Message}", ex.Message);
                else
                    Logger.LogError(ex, "Error in HandleTypingUsersChanged");
            }
        }
    }

    private async Task StartTypingAsync()
    {
        if (isTyping || !channelId.HasValue) return;
        isTyping = true;
        await ChatService.StartTypingAsync(channelId.Value, Username);
    }

    private async Task StopTypingAsync()
    {
        if (!isTyping || !channelId.HasValue) return;
        isTyping = false;
        await ChatService.StopTypingAsync(channelId.Value, Username);

        typingCts?.Cancel();
        typingCts?.Dispose();
        typingCts = null;
    }

    #endregion

    #region Input Handling

    private async Task OnInputChangedInternal()
    {
        await JS.InvokeVoidAsync("autoResizeTextarea", TextareaId);

        // Handle typing state
        if (!string.IsNullOrWhiteSpace(messageText) && !isTyping)
        {
            await StartTypingAsync();
        }
        else if (string.IsNullOrWhiteSpace(messageText) && isTyping)
        {
            await StopTypingAsync();
        }

        // Reset typing timeout - cancel previous and start new
        typingCts?.Cancel();
        typingCts?.Dispose();

        if (!string.IsNullOrWhiteSpace(messageText))
        {
            typingCts = new CancellationTokenSource();
            _ = StopTypingAfterDelayAsync(typingCts.Token);
        }
    }

    private async Task StopTypingAfterDelayAsync(CancellationToken token)
    {
        try
        {
            await Task.Delay(3000, token);
            await StopTypingAsync();
        }
        catch (OperationCanceledException)
        {
            // Timer was reset or cancelled, ignore
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        // On touch devices, Enter creates newline (use send button to send)
        // On desktop, Enter sends message (Shift+Enter for newline)
        // Note: preventDefault is handled client-side via JS to avoid race conditions
        if (e.Key == "Enter" && !e.ShiftKey && !isTouchDevice)
        {
            await HandleSend();
        }
    }

    private async Task HandleSend()
    {
        if (string.IsNullOrWhiteSpace(messageText) || !channelId.HasValue) return;

        var content = messageText;
        messageText = "";

        // Reset textarea height after clearing content
        try { await JS.InvokeVoidAsync("resetTextareaHeight", TextareaId); }
        catch (Exception ex) { Logger.LogWarning(ex, "Failed to reset textarea height"); }

        try
        {
            await ChatService.SendMessageAsync(channelId.Value, UserId, Username, content, replyToMessageId: ReplyingToMessage?.Id);
            await StopTypingAsync();
            if (ReplyingToMessage != null)
            {
                await OnCancelReply.InvokeAsync();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to send message");
        }
    }

    #endregion

    #region Emoji Picker

    private void ToggleEmojiPicker()
    {
        showEmojiPicker = !showEmojiPicker;
    }

    private async Task HandleCancelReply()
    {
        await OnCancelReply.InvokeAsync();
    }

    private void CloseEmojiPicker()
    {
        showEmojiPicker = false;
    }

    private async Task HandleEmojiSelected(string emoji)
    {
        try { await JS.InvokeVoidAsync("insertTextAtCursor", TextareaId, emoji); }
        catch (Exception ex) { Logger.LogWarning(ex, "Failed to insert emoji at cursor"); }

        if (OnEmojiUsed.HasDelegate)
        {
            await OnEmojiUsed.InvokeAsync(emoji);
        }
    }

    #endregion

    #region File Upload

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        if (!channelId.HasValue) return;

        // Get file count for UI (validation happens in JS/controller)
        var fileCount = e.GetMultipleFiles(10).Count;
        if (fileCount == 0) return;

        try
        {
            // Show upload indicator
            isUploading = true;
            uploadingCount = fileCount;
            StateHasChanged();

            Logger.LogInformation("Upload started: {Count} file(s) via HTTP", fileCount);

            // Step 1: Upload all files in parallel via HTTP (browser opens 6 connections)
            var result = await JS.InvokeAsync<UploadResult>("uploadFilesParallel", FileInputId);

            if (!result.Success)
            {
                ShowWarning("Upload failed", result.Error ?? "No valid files selected");
                return;
            }

            // Show warning for partial failures (some files uploaded, some failed)
            if (!string.IsNullOrEmpty(result.Error))
            {
                ShowWarning($"{result.SuccessCount} of {result.TotalCount} files uploaded", result.Error);
            }

            Logger.LogInformation("HTTP upload complete: {Success}/{Total} files", result.SuccessCount, result.TotalCount);

            // Separate into images and videos by type returned from server
            var imageFiles = result.Files.Where(f => f.Type == "image").ToList();
            var videoFiles = result.Files.Where(f => f.Type == "video").ToList();

            // Check FFmpeg availability for video files
            if (videoFiles.Count > 0 && !VideoService.IsAvailable)
            {
                ShowWarning("Video processing unavailable", "FFmpeg is not installed on the server. Video uploads require FFmpeg.");
                // Clean up uploaded video files
                foreach (var vf in videoFiles)
                    try { File.Delete(vf.Path); } catch { }
                videoFiles.Clear();
            }

            // Step 2a: Generate image thumbnails (800px) in parallel, track time per file
            var imageTimes = new System.Collections.Concurrent.ConcurrentDictionary<string, long>();
            if (imageFiles.Count > 0)
            {
                await Parallel.ForEachAsync(imageFiles, new ParallelOptions { MaxDegreeOfParallelism = 4 },
                    async (file, _) =>
                    {
                        var sw = System.Diagnostics.Stopwatch.StartNew();
                        await ImageService.GenerateMediumThumbnailAsync(file.Path);
                        imageTimes[Path.GetFileName(file.Path)] = sw.ElapsedMilliseconds;
                        Logger.LogDebug("Medium thumbnail generated: {FileName}", Path.GetFileName(file.Path));
                    });
            }

            // Step 2b: Generate video poster frames (blocking, fast)
            if (videoFiles.Count > 0)
            {
                foreach (var vf in videoFiles)
                {
                    await VideoService.GeneratePosterAsync(vf.Path);
                    Logger.LogDebug("Video poster generated: {FileName}", Path.GetFileName(vf.Path));
                }
            }

            // Upload complete - hide indicator BEFORE message send.
            uploadingCount = 0;
            isUploading = false;
            StateHasChanged();

            // Step 3: Send message (event dispatch to all circuits happens here)
            var imageUrls = imageFiles.Select(f => f.Url).ToList();
            var videoUrls = videoFiles.Select(f => f.Url).ToList();

            if (imageUrls.Count > 0 || videoUrls.Count > 0)
            {
                await ChatService.SendMessageAsync(channelId.Value, UserId, Username, "",
                    imageUrls.Count > 0 ? imageUrls : null,
                    videoUrls: videoUrls.Count > 0 ? videoUrls : null);
                Logger.LogInformation("Message posted with {ImageCount} image(s), {VideoCount} video(s)", imageUrls.Count, videoUrls.Count);
            }

            // Step 4: Background processing
            var logger = Logger;

            // 4a: Generate large image thumbnails in background + update processing time
            if (imageFiles.Count > 0)
            {
                var mediaLog = MediaLog; // Capture for background task
                var imgTimes = imageTimes;
                _ = Task.Run(async () =>
                {
                    try
                    {
                        await Parallel.ForEachAsync(imageFiles, new ParallelOptions { MaxDegreeOfParallelism = 4 },
                            async (file, _) =>
                            {
                                var sw = System.Diagnostics.Stopwatch.StartNew();
                                await ImageService.GenerateLargeThumbnailAsync(file.Path);
                                sw.Stop();

                                var storedFileName = Path.GetFileName(file.Path);
                                var mediumMs = imgTimes.GetValueOrDefault(storedFileName, 0);
                                var totalMs = mediumMs + sw.ElapsedMilliseconds;
                                await mediaLog.SetCompressDurationAsync(storedFileName, totalMs);

                                logger.LogDebug("Large thumbnail generated: {FileName}", storedFileName);
                            });
                    }
                    catch (Exception ex)
                    {
                        logger.LogError(ex, "Error generating large thumbnails");
                    }
                });
            }

            // 4b: Compress videos in background (fire-and-forget)
            if (videoFiles.Count > 0)
            {
                var mediaLog = MediaLog; // Capture for background task
                _ = Task.Run(async () =>
                {
                    foreach (var vf in videoFiles)
                    {
                        try
                        {
                            var (compressedPath, durationMs) = await VideoService.CompressVideoAsync(vf.Path);
                            if (compressedPath != null && durationMs > 0)
                            {
                                var storedFileName = Path.GetFileName(vf.Path);
                                await mediaLog.SetCompressDurationAsync(storedFileName, durationMs);
                            }
                            logger.LogInformation("Video compressed: {FileName}", Path.GetFileName(vf.Path));
                        }
                        catch (Exception ex)
                        {
                            logger.LogError(ex, "Error compressing video {FileName}", Path.GetFileName(vf.Path));
                        }
                    }
                });
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Upload failed");
            ShowWarning("Upload failed", "Something went wrong while uploading your files");
        }
        finally
        {
            // Safety net - ensure indicator is always hidden even on error paths
            if (isUploading)
            {
                uploadingCount = 0;
                await InvokeAsync(() =>
                {
                    isUploading = false;
                    StateHasChanged();
                });
            }
        }
    }

    // DTOs for JS interop
    private record UploadResult(bool Success, string? Error, UploadedFile[] Files, int TotalCount, int SuccessCount);
    private record UploadedFile(string Url, string Path, string Type);

    private void ShowWarning(string title, string message)
    {
        warningTitle = title;
        warningMessage = message;
    }

    private void DismissWarning()
    {
        warningTitle = "";
        warningMessage = "";
    }

    #endregion

    #region Drag and Drop

    private void HandleDragEnter(DragEventArgs e) => isDraggingOver = true;
    private void HandleDragOver(DragEventArgs e) => isDraggingOver = true;
    private void HandleDragLeave(DragEventArgs e) => isDraggingOver = false;
    private void HandleDrop(DragEventArgs e) => isDraggingOver = false;

    #endregion

    public async ValueTask DisposeAsync()
    {
        typingCts?.Cancel();
        typingCts?.Dispose();

        // Unsubscribe from events
        ChatService.OnTypingUsersChanged -= HandleTypingUsersChanged;

        // Stop typing if we were
        if (isTyping)
        {
            await StopTypingAsync();
        }
    }
}

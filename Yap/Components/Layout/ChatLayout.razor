@inherits LayoutComponentBase
@inject UserStateService UserState
@inject ChatNavigationState NavState
@inject NavigationManager Navigation
@implements IDisposable

<div class="chat-container">
    <ChatHeader />

    <div class="chat-main">
        <div class="messages-container">
            <ErrorBoundary @ref="errorBoundary">
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent Context="ex">
                    <div class="error-content">
                        <h3>Something went wrong</h3>
                        <p>@ex.Message</p>
                        <button class="error-retry-button" @onclick="Recover">Try Again</button>
                        <button class="error-reload-button" onclick="location.reload()">Reload Page</button>
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </div>

        <ChatSidebar />
    </div>

    <div class="sidebar-backdrop @(NavState.SidebarOpen ? "show" : "")" @onclick="NavState.ToggleSidebar"></div>

    <PwaInstallBanner />
</div>

@code {
    private ErrorBoundary? errorBoundary;

    protected override void OnInitialized()
    {
        NavState.OnChange += StateHasChanged;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        // Auth guard - redirect to login if not authenticated
        // UserState is populated by AuthMiddleware before Blazor starts
        if (firstRender && !UserState.IsLoggedIn)
        {
            var currentUrl = Navigation.ToBaseRelativePath(Navigation.Uri);
            var returnUrl = Uri.EscapeDataString("/" + currentUrl);
            Navigation.NavigateTo($"/?returnUrl={returnUrl}");
        }
    }

    private void Recover()
    {
        errorBoundary?.Recover();
    }

    public void Dispose()
    {
        NavState.OnChange -= StateHasChanged;
    }
}

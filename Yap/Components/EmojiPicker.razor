@using Yap.Services
@inject EmojiService EmojiService
@inject CustomEmojiService CustomEmojiService
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="emoji-picker" data-textarea-id="@TextareaId" @ref="pickerElement">
    <div class="emoji-sidebar">
        @* Category jumps are client-side (chat.js): the tap clears any active search and
           scrolls the section into view — no Blazor handlers, no round trips. *@
        <button class="category-btn" data-category="recent" title="Recent">
            @EmojiService.GetEmojiHtml("🕐")
        </button>
        @* One tab per image-emoji pack: server customs first, then built-in packs *@
        @foreach (var pack in CustomEmojiService.Packs)
        {
            <button class="category-btn" data-category="@pack.Key" title="@pack.DisplayName">
                @EmojiService.RenderCustomEmoji(pack.Emojis[0])
            </button>
        }
        @foreach (var category in EmojiData.Categories)
        {
            <button class="category-btn" data-category="@category.Key" title="@CapitalizeFirst(category.Key)">
                @EmojiService.GetEmojiHtml(category.Value.Icon)
            </button>
        }
    </div>

    <div class="emoji-content" @ref="contentElement">
        <div class="emoji-search">
            @* Search is fully client-side: chat.js (filterEmojiPicker) filters the mounted
               grid in place against each cell's data-kw — zero round trips, results appear
               grouped under their section headers. The ✕ is CSS-hidden while the box is
               empty (:placeholder-shown — the placeholder must never be empty) and JS
               clears + re-filters on click. *@
            <input type="text" placeholder="Search emojis..." />
            <button class="emoji-search-clear" title="Clear search">✕</button>
        </div>
        <div class="emoji-empty emoji-search-empty" hidden>No emojis found</div>

        @* Recent section *@
        <div class="emoji-section" data-section="recent">
            <div class="section-header">Recent</div>
            <div class="emoji-grid">
                @if (frozenRecents.Count > 0)
                {
                    @foreach (var emoji in frozenRecents)
                    {
                        var e = emoji;
                        <button class="emoji-btn" data-emoji="@e" data-kw="@GetKeywords(e)" @attributes="GetClickAttributes(e)">
                            @if (IsCustomEmojiString(e))
                            {
                                var ce = GetCustomEmojiFromString(e);
                                if (ce != null)
                                {
                                    @EmojiService.RenderCustomEmoji(ce)
                                }
                                else
                                {
                                    @e
                                }
                            }
                            else
                            {
                                @EmojiService.GetEmojiHtml(e)
                            }
                        </button>
                    }
                }
                else
                {
                    <div class="emoji-empty">No recent emojis yet</div>
                }
            </div>
        </div>

        @* Image-emoji sections, one per pack *@
        @foreach (var pack in CustomEmojiService.Packs)
        {
            <div class="emoji-section" data-section="@pack.Key">
                <div class="section-header">@pack.DisplayName</div>
                <div class="emoji-grid">
                    @foreach (var emoji in pack.Emojis)
                    {
                        var shortcode = $":{emoji.Shortcode}:";
                        <button class="emoji-btn" data-emoji="@shortcode" data-kw="@GetKeywords(shortcode)" @attributes="GetClickAttributes(shortcode)" title="@shortcode">
                            @EmojiService.RenderCustomEmoji(emoji, "22px")
                        </button>
                    }
                </div>
            </div>
        }

        @* Standard categories *@
        @foreach (var category in EmojiData.Categories)
        {
            <div class="emoji-section" data-section="@category.Key">
                <div class="section-header">@CapitalizeFirst(category.Key)</div>
                <div class="emoji-grid">
                    @foreach (var emoji in category.Value.Emojis)
                    {
                        var e = emoji;
                        <button class="emoji-btn" data-emoji="@e" data-kw="@GetKeywords(e)" @attributes="GetClickAttributes(e)">@EmojiService.GetEmojiHtml(e)</button>
                    }
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public List<string> RecentEmojis { get; set; } = new();
    [Parameter] public EventCallback<string> OnEmojiSelected { get; set; }
    [Parameter] public Action<string>? OnEmojiUsed { get; set; }
    [Parameter] public string TextareaId { get; set; } = "";

    private ElementReference pickerElement;
    private ElementReference contentElement;
    private IJSObjectReference? scrollTracker;
    private DotNetObjectReference<EmojiPicker>? _dotNetRef;

    // Snapshot of recents taken on init — won't shift under the user's fingers
    private List<string> frozenRecents = new();

    private bool _hasRenderedOnce;

    // Set by OnPickerOpened: the always-mounted picker needs one re-render per open.
    private bool _openRefreshPending;

    private bool IsClientInsertionMode => !string.IsNullOrEmpty(TextareaId);

    // Renders are rare by design: the grid is static after mount — only the first render
    // and the per-open recents refresh re-diff it. Search, category jumps and insertion
    // are all client-side (chat.js), so parent cascades have nothing to update here.
    protected override bool ShouldRender()
    {
        if (!_hasRenderedOnce)
        {
            _hasRenderedOnce = true;
            return true;
        }
        if (_openRefreshPending)
        {
            _openRefreshPending = false;
            return true;
        }
        return false;
    }

    /// <summary>
    /// Called from chat.js each time the mounted-hidden picker becomes visible (input-mode
    /// only — reaction-mode instances mount fresh per open and never receive this). The
    /// component lives across many opens, so per-open state refreshes here instead of
    /// OnInitialized: recents re-freeze Discord-style (updated between opens, never
    /// shifting under the user's fingers mid-open); chat.js resets the search box itself.
    /// RecentEmojis stays live because ChatBase mutates the same list instance in place.
    /// </summary>
    [JSInvokable]
    public async Task OnPickerOpened()
    {
        frozenRecents = new List<string>(RecentEmojis);
        _openRefreshPending = true;
        try { await InvokeAsync(StateHasChanged); }
        catch { /* circuit may be dead */ }
    }

    protected override void OnInitialized()
    {
        frozenRecents = new List<string>(RecentEmojis);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                scrollTracker = await JS.InvokeAsync<IJSObjectReference>("initEmojiPickerScroll", contentElement);
            }
            catch { /* Ignore JS errors */ }

            // Set up client-side click handler for instant emoji insertion (no server round-trip).
            // The DotNet ref enables fire-and-forget bookkeeping (recents + counts) from JS,
            // avoiding the @onclick→EventCallback path that would force a parent re-render.
            try
            {
                _dotNetRef = DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("setupEmojiPickerClick", TextareaId, _dotNetRef);
            }
            catch { /* Ignore JS errors */ }

            // Refresh-on-open hook for the always-mounted input picker (chat.js ignores
            // reaction-mode instances — they don't sit inside a data-picker-pane).
            try
            {
                await JS.InvokeVoidAsync("registerPickerOpenHook", pickerElement, _dotNetRef);
            }
            catch { /* Ignore JS errors */ }
        }
    }

    // In client-insertion mode it returns null, so no Blazor event handler is attached
    // and the click is handled purely by chat.js. In reaction mode (no TextareaId —
    // e.g., MessageItem) it attaches @onclick → SelectEmoji as before.
    private IReadOnlyDictionary<string, object>? GetClickAttributes(string emoji)
    {
        if (IsClientInsertionMode) return null;
        return new Dictionary<string, object>
        {
            ["onclick"] = EventCallback.Factory.Create(this, () => SelectEmoji(emoji))
        };
    }

    [JSInvokable]
    public void RecordEmojiUsed(string emoji)
    {
        OnEmojiUsed?.Invoke(emoji);
    }

    private async Task SelectEmoji(string emoji)
    {
        await OnEmojiSelected.InvokeAsync(emoji);
    }

    /// <summary>
    /// The client-side search corpus for one cell, rendered as its data-kw attribute
    /// (~40KB across the grid, riding the background mount). Custom emojis match on
    /// their shortcode; standard emojis on their curated keyword string — the same
    /// substring semantics the old server-side search had. Lowercased here so chat.js
    /// compares with a plain includes().
    /// </summary>
    private static string GetKeywords(string e) =>
        IsCustomEmojiString(e)
            ? e[1..^1].ToLowerInvariant()
            : EmojiData.EmojiKeywords.GetValueOrDefault(e)?.ToLowerInvariant() ?? "";

    private static string CapitalizeFirst(string s) =>
        string.IsNullOrEmpty(s) ? s : char.ToUpper(s[0]) + s[1..];

    private static bool IsCustomEmojiString(string s) =>
        s.Length > 2 && s[0] == ':' && s[^1] == ':' && !s.AsSpan(1, s.Length - 2).Contains(':');

    private CustomEmoji? GetCustomEmojiFromString(string s) =>
        IsCustomEmojiString(s) ? CustomEmojiService.GetByShortcode(s[1..^1]) : null;

    public async ValueTask DisposeAsync()
    {
        if (scrollTracker is not null)
        {
            try
            {
                await scrollTracker.InvokeVoidAsync("dispose");
                await scrollTracker.DisposeAsync();
            }
            catch { /* Circuit may already be gone */ }
        }
        _dotNetRef?.Dispose();
    }
}

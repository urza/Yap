@using Yap.Models
@using Yap.Services
@using Yap.Services.Gifs
@inject EmojiService EmojiService
@inject UserStateService UserState
@inject IJSRuntime JS
@inject VideoService VideoService
@inject GifService GifService
@inject UserService UserService

<div class="message-group @(IsSystem ? "system-message" : "") @(ShowHeader ? "has-header" : "") @(showEmojiPicker ? "picker-open" : "") @(ReplyToMessage != null ? "has-reply" : "") @(IsReplyTarget ? "reply-target" : "")"
     id="msg-@Message.Id"
     @ontouchstart="HandleTouchStart"
     @ontouchstart:stopPropagation>

    @if (ReplyToMessage != null)
    {
        <div class="reply-preview" @onclick="HandleReplyPreviewClick" @onclick:stopPropagation>
            <Avatar Username="@ReplyToMessage.Username"
                    ProfilePictureUrl="@ReplyToProfilePictureUrl"
                    Size="AvatarSize.Small" />
            <span class="reply-author">@(ReplyToDisplayName ?? ReplyToMessage.Username)</span>
            <span class="reply-text">@EmojiService.ConvertEmojisToTwemoji(GetReplyPreviewText(), forceSmall: true)</span>
        </div>
    }

    @if (ShowHeader)
    {
        <Avatar Username="@Message.Username"
                ProfilePictureUrl="@ProfilePictureUrl"
                Size="AvatarSize.Medium" />
    }

    <div class="message-body">
        @if (ShowHeader)
        {
            <div class="message-meta">
                <strong class="message-username">@EmojiService.ConvertEmojisToTwemoji(DisplayName ?? Message.Username, inline: true)</strong>
                @if (IsBot)
                {
                    <span class="bot-badge" title="Bot">@EmojiService.ConvertEmojisToTwemoji("🤖", inline: true)</span>
                }
                <span class="message-time">@FormatTimestamp()</span>
            </div>
        }

        <div class="message-content">
        @if (IsEditing)
        {
            <div class="edit-container">
                <input type="text" value="@EditContent" @oninput="OnEditInput"
                       class="edit-input" @onkeydown="HandleEditKeyDown" />
                <div class="edit-actions">
                    <button class="edit-save" @onclick="() => OnSaveEdit.InvokeAsync()" title="Save">✓</button>
                    <button class="edit-cancel" @onclick="() => OnCancelEdit.InvokeAsync()" title="Cancel">✕</button>
                </div>
            </div>
        }
        else if (Message.HasMedia)
        {
            @if (Message.HasImages)
            {
                var imageCount = Message.ImageUrls.Count;
                var isSingle = imageCount == 1;

                <div class="image-gallery @(isSingle ? "gallery-single" : "")">
                    @* Lazy load with dimensions for proper space reservation before image loads *@
                    @if (isSingle)
                    {
                        <div class="gallery-item"
                             @onclick="() => OnImageClick.InvokeAsync((Message.ImageUrls, 0))">
                            <img src="@ImageService.GetMediumUrl(Message.ImageUrls[0])" alt="Uploaded image" class="gallery-image"
                                 loading="lazy" width="800" height="600" />
                        </div>
                    }
                    else
                    {
                        @* Multi-image: rows of max 3 *@
                        @foreach (var row in GetImageRows())
                        {
                            <div class="gallery-row">
                                @foreach (var (imageUrl, globalIndex) in row)
                                {
                                    var idx = globalIndex;
                                    <div class="gallery-item"
                                         @onclick="() => OnImageClick.InvokeAsync((Message.ImageUrls, idx))">
                                        <img src="@ImageService.GetMediumUrl(imageUrl)" alt="Uploaded image" class="gallery-image"
                                             loading="lazy" width="800" height="800" />
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
            }
            @if (Message.HasVideos)
            {
                <div class="video-gallery">
                @for (int vi = 0; vi < Message.VideoUrls.Count; vi++)
                {
                    var url = Message.VideoUrls[vi];
                    var idx = vi;
                    <div class="video-container" @ref="videoContainerRefs[idx]">
                        <video preload="none" poster="@VideoService.GetPosterUrl(url)"
                               class="video-player">
                            <source src="@VideoService.GetCompressedUrl(url)" type="video/mp4" />
                            <source src="@url" />
                        </video>
                        <div class="video-play-overlay" @onclick="() => PlayVideoByIndex(idx)" @onclick:stopPropagation="true">
                            <svg class="play-icon" viewBox="0 0 64 64" fill="white">
                                <circle cx="32" cy="32" r="30" fill="rgba(0,0,0,0.5)" />
                                <polygon points="26,20 26,44 46,32" />
                            </svg>
                        </div>
                    </div>
                }
                </div>
            }
            @if (Message.HasGifs)
            {
                <div class="gif-message-gallery">
                @foreach (var att in Message.GifAttachments)
                {
                    var entry = GifService.GetEntry(att.GifEntryId);
                    var w = att.Width > 0 ? att.Width : entry?.Width ?? 0;
                    var h = att.Height > 0 ? att.Height : entry?.Height ?? 0;
                    var aspect = (w > 0 && h > 0) ? $"aspect-ratio: {w}/{h}; max-width: min(360px, {w}px);" : "max-width: 320px;";
                    var sources = BuildGifSources(entry);
                    var isFav = entry != null && GifService.IsFavorite(CurrentUserId, entry.Id);
                    var uploader = entry?.UploadedByUserId is Guid uid ? UserService.GetById(uid)?.EffectiveDisplayName : null;
                    var gifId = att.GifEntryId;
                    <div class="gif-message" style="@aspect">
                        @if (sources.Count > 0)
                        {
                            <video autoplay loop muted playsinline preload="metadata" width="@(w > 0 ? w.ToString() : null)" height="@(h > 0 ? h.ToString() : null)">
                                @foreach (var (url, type) in sources)
                                {
                                    <source src="@url" type="@type" />
                                }
                            </video>
                        }
                        else
                        {
                            <div class="gif-message-missing">GIF unavailable</div>
                        }
                        @if (entry != null)
                        {
                            <button class="gif-message-fav @(isFav ? "favorited" : "")"
                                    @onclick="@(() => ToggleGifFavorite(gifId))" @onclick:stopPropagation="true"
                                    title="@(isFav ? "Remove from favorites" : "Add to favorites")">
                                <svg viewBox="0 0 24 24" fill="currentColor" width="14" height="14">
                                    <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                                </svg>
                            </button>
                            @if (!string.IsNullOrEmpty(uploader))
                            {
                                <div class="gif-message-uploader" title="Uploaded by @uploader">via @uploader</div>
                            }
                        }
                    </div>
                }
                </div>
            }
        }
        else if (IsBot && Message.Content.Contains("[pwa-install]"))
        {
            @EmojiService.ConvertEmojisToTwemoji(GetTextBefore("[pwa-install]"))
            <span class="bot-action-link" @onclick="HandlePwaInstall" @ontouchend="HandlePwaInstall" @ontouchend:preventDefault>install it</span>
            @EmojiService.ConvertEmojisToTwemoji(GetTextAfter("[pwa-install]"))
        }
        else
        {
            @EmojiService.ProcessMessageContent(Message.Content)
            @if (Message.IsEdited)
            {
                <span class="edited-indicator">(edited)</span>
            }
        }
        </div>

        @* Link preview cards / Media players *@
        @if (LinkPreviews != null)
        {
            @foreach (var preview in LinkPreviews)
            {
                @if (!string.IsNullOrEmpty(preview.CachedMediaUrl))
                {
                    <MediaPlayer Preview="@preview" />
                }
                else
                {
                    <LinkPreviewCard Preview="@preview" />
                }
            }
        }

        @* Reactions display *@
        @if (Message.Reactions?.Count > 0)
        {
            <div class="reactions-display">
                @foreach (var reactionGroup in Message.Reactions.GroupByEmoji())
                {
                    var emoji = reactionGroup.Key;
                    var users = reactionGroup.Value;
                    var hasReacted = users.Any(u => u.Equals(CurrentUsername, StringComparison.OrdinalIgnoreCase));
                    <button class="reaction-pill @(hasReacted ? "reacted" : "")"
                            @onclick="() => OnReaction.InvokeAsync(emoji)"
                            title="@string.Join(", ", users)">
                        @EmojiService.ConvertEmojisToTwemoji(emoji, forceSmall: true) <span class="reaction-count">@users.Count</span>
                    </button>
                }
            </div>
        }
    </div>

    @* Backdrop to close emoji picker when clicking outside *@
    @if (showEmojiPicker)
    {
        <div class="emoji-picker-backdrop" @onclick="CloseEmojiPicker"></div>
    }

    @* Message actions popup - always rendered, visibility controlled by CSS :hover *@
    @if (!IsSystem && !IsEditing)
    {
        <div class="message-actions">
            @foreach (var emoji in GetQuickReactions())
            {
                var e = emoji;
                <button class="action-btn" @onclick="@(() => HandleQuickReaction(e))" title="@e">@EmojiService.ConvertEmojisToTwemoji(e, forceSmall: true)</button>
            }
            <div class="action-divider"></div>
            <button class="action-btn action-picker" @ref="pickerAnchorRef" @onclick="ToggleEmojiPicker" @onclick:stopPropagation="true" title="Add Reaction">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-5-6c.78 2.34 2.72 4 5 4s4.22-1.66 5-4H7zm8-4c.55 0 1-.45 1-1s-.45-1-1-1-1 .45-1 1 .45 1 1 1zm-6 0c.55 0 1-.45 1-1s-.45-1-1-1-1 .45-1 1 .45 1 1 1z"/>
                </svg>
            </button>
            <button class="action-btn action-reply" @onclick="HandleReplyClick" title="Reply">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M10 9V5l-7 7 7 7v-4.1c5 0 8.5 1.6 11 5.1-1-5-4-10-11-11z"/>
                </svg>
            </button>
            @if (IsOwn && !Message.HasMedia)
            {
                <button class="action-btn action-edit" @onclick="() => OnStartEdit.InvokeAsync()" title="Edit">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/>
                    </svg>
                </button>
            }
            @if (IsOwn)
            {
                <button class="action-btn action-delete" @onclick="() => OnDelete.InvokeAsync()" title="Delete">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/>
                    </svg>
                </button>
            }

        </div>

        @if (showEmojiPicker)
        {
            <div class="emoji-picker-wrapper" @ref="pickerWrapperRef">
                <EmojiPicker RecentEmojis="RecentEmojis"
                             OnEmojiSelected="HandleEmojiSelected" />
            </div>
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public ChatMessage Message { get; set; } = default!;
    [Parameter] public bool ShowHeader { get; set; }
    [Parameter] public bool IsEditing { get; set; }
    [Parameter] public string CurrentUsername { get; set; } = "";
    [Parameter] public string? ProfilePictureUrl { get; set; }
    [Parameter] public string? DisplayName { get; set; }
    [Parameter] public List<string> RecentEmojis { get; set; } = new();  // For full emoji drawer
    [Parameter] public List<string> QuickReactions { get; set; } = new(); // Cached quick reactions
    [Parameter] public bool IsBot { get; set; }
    [Parameter] public bool IsReplyTarget { get; set; }
    [Parameter] public List<Yap.Models.LinkPreview>? LinkPreviews { get; set; }

    // Computed from Message
    private bool IsOwn => Message.Username.Equals(CurrentUsername, StringComparison.OrdinalIgnoreCase);
    private bool IsSystem => Message.Username == "System";

    // Edit state
    [Parameter] public string EditContent { get; set; } = "";
    [Parameter] public EventCallback<string> EditContentChanged { get; set; }

    // Reply parameters
    [Parameter] public ChatMessage? ReplyToMessage { get; set; }
    [Parameter] public string? ReplyToDisplayName { get; set; }
    [Parameter] public string? ReplyToProfilePictureUrl { get; set; }
    [Parameter] public EventCallback OnReply { get; set; }
    [Parameter] public EventCallback OnScrollToMessage { get; set; }

    // Callbacks
    [Parameter] public EventCallback OnTouchStart { get; set; }  // For mobile scroll-dismiss
    [Parameter] public EventCallback<string> OnReaction { get; set; }
    [Parameter] public EventCallback OnStartEdit { get; set; }
    [Parameter] public EventCallback OnSaveEdit { get; set; }
    [Parameter] public EventCallback OnCancelEdit { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }
    [Parameter] public EventCallback<(List<string> Images, int Index)> OnImageClick { get; set; }

    private string FormatTimestamp()
    {
        var tz = UserState.GetTimeZoneInfo();
        var fmt = UserState.GetDateTimeFormat();
        var ic = UserState.GetCultureInfo();
        var local = TimeZoneInfo.ConvertTime(Message.Timestamp, tz);
        var now = TimeZoneInfo.ConvertTime(DateTimeOffset.UtcNow, tz);

        var time = local.ToString(fmt.Time, ic);

        if (local.Date == now.Date)
            return time;
        if (local.Date == now.Date.AddDays(-1))
            return $"Yesterday {time}";
        if (local.Year == now.Year)
            return $"{local.ToString(fmt.DateInYear, ic)} {time}";
        return $"{local.ToString(fmt.FullDate, ic)} {time}";
    }

    private string GetReplyPreviewText()
    {
        if (ReplyToMessage == null) return "";
        if (ReplyToMessage.HasMedia && string.IsNullOrEmpty(ReplyToMessage.Content))
            return "Click to see attachment";
        return ReplyToMessage.Content;
    }

    private async Task HandleTouchStart()
    {
        await OnTouchStart.InvokeAsync();
    }

    private async Task OnEditInput(ChangeEventArgs e)
    {
        await EditContentChanged.InvokeAsync(e.Value?.ToString() ?? "");
    }

    private async Task HandleEditKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await OnSaveEdit.InvokeAsync();
        else if (e.Key == "Escape") await OnCancelEdit.InvokeAsync();
    }

    /// <summary>
    /// Groups images into rows of 2 or 3, avoiding single-image rows.
    /// </summary>
    private List<List<(string Url, int Index)>> GetImageRows()
    {
        var images = Message.ImageUrls;

        int[] rowSizes = images.Count switch
        {
            2 => [2],
            3 => [3],
            4 => [2, 2],
            5 => [2, 3],
            6 => [3, 3],
            7 => [2, 2, 3],
            8 => [2, 3, 3],
            9 => [3, 3, 3],
            10 => [2, 2, 3, 3],
            _ => []
        };

        var rows = new List<List<(string, int)>>();
        var index = 0;
        foreach (var size in rowSizes)
        {
            var row = new List<(string, int)>();
            for (int i = 0; i < size; i++)
                row.Add((images[index], index++));
            rows.Add(row);
        }

        return rows;
    }

    // Video player state - dynamically sized to match video count
    private ElementReference[] videoContainerRefs = Array.Empty<ElementReference>();

    protected override void OnParametersSet()
    {
        if (Message.HasVideos && Message.VideoUrls.Count != videoContainerRefs.Length)
            videoContainerRefs = new ElementReference[Message.VideoUrls.Count];
    }

    private async Task PlayVideoByIndex(int index)
    {
        if (index < videoContainerRefs.Length)
        {
            try { await JS.InvokeVoidAsync("playVideo", videoContainerRefs[index]); }
            catch { /* Ignore JS errors during disconnect */ }
        }
    }

    // Emoji picker state
    private bool showEmojiPicker = false;
    private bool pendingPosition = false;
    private ElementReference pickerAnchorRef;
    private ElementReference pickerWrapperRef;

    private IEnumerable<string> GetQuickReactions() => QuickReactions;

    private async Task ToggleEmojiPicker()
    {
        showEmojiPicker = !showEmojiPicker;
        if (showEmojiPicker)
        {
            pendingPosition = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (pendingPosition && showEmojiPicker)
        {
            pendingPosition = false;
            try
            {
                await JS.InvokeVoidAsync("positionEmojiPickerFixed", pickerWrapperRef, pickerAnchorRef);
            }
            catch { /* Ignore JS errors during disconnect */ }
        }
    }

    private void CloseEmojiPicker()
    {
        showEmojiPicker = false;
    }

    private async Task HandleReplyClick()
    {
        // Focus handled by pointerdown listener in chat.js (needs user gesture context for mobile keyboard)
        await OnReply.InvokeAsync();
    }

    private async Task HandleReplyPreviewClick()
    {
        await OnScrollToMessage.InvokeAsync();
    }

    private async Task HandleQuickReaction(string emoji)
    {
        await OnReaction.InvokeAsync(emoji);
    }

    private async Task HandleEmojiSelected(string emoji)
    {
        showEmojiPicker = false;
        await OnReaction.InvokeAsync(emoji);
    }

    private async Task HandlePwaInstall()
    {
        try { await JS.InvokeVoidAsync("showPwaInstallGuide"); }
        catch { /* Ignore JS errors during disconnect */ }
    }

    private Guid CurrentUserId => UserState.UserId ?? Guid.Empty;

    private static readonly (string, string)[] GifSourceOrder = new[]
    {
        ("local-webm", "video/webm"),
        ("local-mp4",  "video/mp4"),
        ("local-gif",  "image/gif"),
        ("remote-webm","video/webm"),
        ("remote-mp4", "video/mp4"),
        ("remote-gif", "image/gif"),
    };

    private List<(string Url, string Type)> BuildGifSources(GifEntry? entry)
    {
        var list = new List<(string, string)>();
        if (entry == null) return list;
        if (!string.IsNullOrEmpty(entry.WebmUrl))      list.Add((entry.WebmUrl!,      "video/webm"));
        if (!string.IsNullOrEmpty(entry.Mp4Url))       list.Add((entry.Mp4Url!,       "video/mp4"));
        if (!string.IsNullOrEmpty(entry.GifUrl))       list.Add((entry.GifUrl!,       "image/gif"));
        if (!string.IsNullOrEmpty(entry.RemoteWebmUrl))list.Add((entry.RemoteWebmUrl!,"video/webm"));
        if (!string.IsNullOrEmpty(entry.RemoteMp4Url)) list.Add((entry.RemoteMp4Url!, "video/mp4"));
        if (!string.IsNullOrEmpty(entry.RemoteGifUrl)) list.Add((entry.RemoteGifUrl!, "image/gif"));
        return list;
    }

    private async Task ToggleGifFavorite(Guid gifEntryId)
    {
        await GifService.ToggleFavoriteAsync(CurrentUserId, gifEntryId);
    }

    private string GetTextBefore(string marker)
    {
        var idx = Message.Content.IndexOf(marker);
        return idx >= 0 ? Message.Content[..idx] : Message.Content;
    }

    private string GetTextAfter(string marker)
    {
        var idx = Message.Content.IndexOf(marker);
        return idx >= 0 ? Message.Content[(idx + marker.Length)..] : "";
    }
}

@using Yap.Models

<div class="combined-picker">
    <div class="combined-tabs">
        <button type="button" class="combined-tab @(activeTab == Tab.Gifs ? "active" : "")"
                @onclick="@(() => SwitchTab(Tab.Gifs))">GIFs</button>
        <button type="button" class="combined-tab @(activeTab == Tab.Emoji ? "active" : "")"
                @onclick="@(() => SwitchTab(Tab.Emoji))">Emoji</button>
    </div>
    <div class="combined-body">
        @* Both pickers stay mounted so tab switches don't dispose state (GIF search, scroll position). *@
        <div class="combined-pane @(activeTab == Tab.Gifs ? "active" : "")">
            <GifPicker CurrentUserId="@CurrentUserId" CurrentUsername="@CurrentUsername"
                       OnGifSelected="OnGifSelected" OnUploadError="OnUploadError" />
        </div>
        <div class="combined-pane @(activeTab == Tab.Emoji ? "active" : "")">
            <EmojiPicker RecentEmojis="@RecentEmojis" OnEmojiUsed="@OnEmojiUsed" TextareaId="@TextareaId" />
        </div>
    </div>
</div>

@code {
    public enum Tab { Gifs, Emoji }

    [Parameter] public Tab InitialTab { get; set; } = Tab.Emoji;
    [Parameter] public Guid CurrentUserId { get; set; }
    [Parameter] public string CurrentUsername { get; set; } = "";
    [Parameter] public EventCallback<GifAttachment> OnGifSelected { get; set; }
    [Parameter] public EventCallback<string> OnUploadError { get; set; }
    [Parameter] public List<string> RecentEmojis { get; set; } = new();
    [Parameter] public Action<string>? OnEmojiUsed { get; set; }
    [Parameter] public string TextareaId { get; set; } = "";

    private Tab activeTab;

    protected override void OnInitialized()
    {
        activeTab = InitialTab;
    }

    private void SwitchTab(Tab tab) => activeTab = tab;
}

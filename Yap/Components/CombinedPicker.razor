@using Yap.Models

@* Tab switching is client-side: chat.js flips data-active-tab on this root and CSS shows
   the matching pane — no circuit round trip. Both pickers stay mounted so switches lose
   no state (GIF search, scroll position), and the active tab survives close/reopen of
   the sheet (the component itself now lives across opens). No @code state at all. *@
<div class="combined-picker" data-active-tab="emoji">
    <div class="combined-tabs">
        <button type="button" class="combined-tab" data-combined-tab="gifs">GIFs</button>
        <button type="button" class="combined-tab" data-combined-tab="emoji">Emoji</button>
    </div>
    <div class="combined-body">
        <div class="combined-pane" data-combined-pane="gifs">
            <GifPicker CurrentUserId="@CurrentUserId" CurrentUsername="@CurrentUsername"
                       OnGifSelected="OnGifSelected" OnUploadError="OnUploadError" />
        </div>
        <div class="combined-pane" data-combined-pane="emoji">
            <EmojiPicker RecentEmojis="@RecentEmojis" OnEmojiUsed="@OnEmojiUsed" TextareaId="@TextareaId" />
        </div>
    </div>
</div>

@code {
    [Parameter] public Guid CurrentUserId { get; set; }
    [Parameter] public string CurrentUsername { get; set; } = "";
    [Parameter] public EventCallback<GifAttachment> OnGifSelected { get; set; }
    [Parameter] public EventCallback<string> OnUploadError { get; set; }
    [Parameter] public List<string> RecentEmojis { get; set; } = new();
    [Parameter] public Action<string>? OnEmojiUsed { get; set; }
    [Parameter] public string TextareaId { get; set; } = "";
}

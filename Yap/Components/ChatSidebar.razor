@inject ChatService ChatService
@inject UserStateService UserState
@inject UserService UserService
@inject ChatConfigService ChatConfig
@inject ChatNavigationState NavState
@inject NavigationManager Navigation
@inject EmojiService EmojiService
@inject SystemBotService BotService
@inject IHttpContextAccessor HttpContextAccessor
@inject ILogger<ChatSidebar> Logger
@implements IDisposable

<div class="users-sidebar @(NavState.SidebarOpen ? "sidebar-open" : "")">
    @* Rooms section *@
    <div class="sidebar-section">
        <h4>ROOMS</h4>
        <div class="rooms-list">
            @foreach (var room in rooms)
            {
                var isActive = NavState.CurrentDmUser == null && NavState.CurrentRoomId == room.Id;
                var hasUnread = !isActive && HasUnreadInRoom(room.Id);
                <div class="room-item @(isActive ? "active" : "") @(hasUnread ? "has-unread" : "")" @onclick="() => SwitchToRoom(room.Id)">
                    <span class="room-icon">#</span>
                    <span class="room-name">@EmojiService.ConvertEmojis(room.Name, inline: true)</span>
                    @if (hasUnread)
                    {
                        <span class="room-unread-dot"></span>
                    }
                    @if (isAdmin)
                    {
                        <button class="room-settings" @onclick="() => OpenChannelSettings(room.Id)"
                                @onclick:stopPropagation="true" title="Channel settings">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58a.49.49 0 0 0 .12-.61l-1.92-3.32a.49.49 0 0 0-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54a.484.484 0 0 0-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96a.49.49 0 0 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.07.62-.07.94s.02.64.07.94l-2.03 1.58a.49.49 0 0 0-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6A3.6 3.6 0 1 1 12 8.4a3.6 3.6 0 0 1 0 7.2z"/>
                            </svg>
                        </button>
                    }
                </div>
            }
            @if (isAdmin)
            {
                <div class="room-item add-room" @onclick="NavigateToCreateRoom">
                    <span class="room-icon">+</span>
                    <span class="room-name">Add Room</span>
                </div>
            }
        </div>
    </div>

    @* Online users section *@
    <div class="sidebar-section">
        <h4>@onlineUsersHeader</h4>
        <div class="users-list">
            @foreach (var (user, status, isMobile) in GetSortedUsersWithStatus())
            {
                var isCurrentUser = user.Equals(Username, StringComparison.OrdinalIgnoreCase);
                var isUserAdmin = ChatService.IsAdmin(user);
                var userUnreadCount = isCurrentUser ? 0 : GetUnreadDMCount(user);
                var isActiveDM = NavState.CurrentDmUser != null && NavState.CurrentDmUser.Equals(user, StringComparison.OrdinalIgnoreCase);
                var statusClass = status.ToString().ToLower();
                var displayName = GetDisplayName(user);

                <div class="user-item @(isCurrentUser ? "current-user" : "") @(isActiveDM ? "active-dm" : "")"
                     @onclick="() => OpenDM(user)">
                    <span class="user-status-dot @statusClass"></span>
                    <span class="user-name"
                          @onmouseenter="@((MouseEventArgs e) => ShowProfile(user, status, e))"
                          @onmouseleave="HideProfile">@EmojiService.ConvertEmojis(displayName, inline: true)@(isCurrentUser ? " (you)" : "")</span>
                    @if (_isMobile)
                    {
                        <button class="profile-info-btn" title="View profile" aria-label="View profile"
                                @onclick="@((MouseEventArgs e) => ToggleProfile(user, status, e))"
                                @onclick:stopPropagation="true">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"/>
                                <path d="M8 14s1.5 2 4 2 4-2 4-2"/>
                                <line x1="9" y1="9" x2="9.01" y2="9"/>
                                <line x1="15" y1="9" x2="15.01" y2="9"/>
                            </svg>
                        </button>
                    }
                    @if (isUserAdmin)
                    {
                        <span class="admin-badge" title="Admin">@EmojiService.ConvertEmojis("👑", inline: true)</span>
                    }
                    @if (BotService.IsBotUser(user))
                    {
                        <span class="bot-badge" title="Bot">@EmojiService.ConvertEmojis("🤖", inline: true)</span>
                    }
                    @if (userUnreadCount > 0)
                    {
                        <span class="dm-unread-badge">@userUnreadCount</span>
                    }
                </div>
            }
        </div>
    </div>
</div>

@* User profile popout — desktop: hover-anchored tooltip; mobile: centered modal with tap-away backdrop.
   Rendered as a sibling of the sidebar so position:fixed isn't clipped by the sidebar's
   overflow:hidden (desktop) or trapped by its slide-in transform (mobile). *@
@if (_popupUser != null)
{
    @if (_isMobile)
    {
        <div class="profile-popup-backdrop" @onclick="HideProfile"></div>
    }
    <div class="profile-popup @(_isMobile ? "is-mobile" : "")" style="@PopupStyle">
        <UserProfileCard Username="@_popupUser" Status="_popupStatus" />
    </div>
}

@code {
    private Guid UserId => UserState.UserId ?? Guid.Empty;
    private string Username => UserState.Username ?? "";

    // Internal state
    private List<Channel> rooms = new();
    private List<(string Username, UserStatus Status, bool? IsMobile)> onlineUsers = new();
    private bool isAdmin = false;
    private string onlineUsersHeader = "";

    // Profile popout state
    private bool _isMobile;
    private string? _popupUser;
    private UserStatus _popupStatus;
    private int _popupX;
    private int _popupY;


    protected override void OnInitialized()
    {
        // Get initial state
        rooms = ChatService.GetRooms();
        RefreshOnlineUsers();
        isAdmin = ChatService.IsAdmin(UserId);
        _isMobile = ResolveIsMobile();
        UpdateOnlineUsersHeader();

        // Subscribe to events
        ChatService.OnChannelCreated += HandleChannelCreated;
        ChatService.OnChannelUpdated += HandleChannelUpdated;
        ChatService.OnChannelDeleted += HandleChannelDeleted;
        ChatService.OnUsersListChanged += HandleUsersListChanged;
        ChatService.OnUserStatusChanged += HandleUserStatusChanged;
        ChatService.OnUnreadChanged += HandleUnreadChanged;
        NavState.OnChange += StateHasChanged;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        // Safety net: if the device type wasn't known at first render (no prior page set
        // UserState.IsMobile and HttpContext was unavailable), resolve it now and re-render
        // so phones get the info button instead of desktop hover.
        if (firstRender)
        {
            var resolved = ResolveIsMobile();
            if (resolved != _isMobile)
            {
                _isMobile = resolved;
                StateHasChanged();
            }
        }
    }

    /// <summary>
    /// Determines whether this is a mobile device. Prefers the session-cached value,
    /// falls back to the User-Agent flag set by DeviceDetectionMiddleware.
    /// </summary>
    private bool ResolveIsMobile()
    {
        if (UserState.IsMobile.HasValue)
            return UserState.IsMobile.Value;

        var ctx = HttpContextAccessor.HttpContext;
        if (ctx?.Items.TryGetValue("IsMobile", out var m) == true && m is bool b)
        {
            UserState.IsMobile = b; // cache for the rest of the session
            return b;
        }

        return false; // assume desktop until proven otherwise
    }

    #region Profile Popout

    // Desktop: hover the name to reveal a profile card next to the cursor.
    // We drive this from Blazor (not pure CSS :hover) because the card must escape the
    // sidebar's overflow:hidden via position:fixed, which needs the cursor coordinates.
    // The round-trip latency reads as a normal tooltip delay here — acceptable for a
    // deliberate, low-frequency popout (unlike per-message action bars).
    private void ShowProfile(string user, UserStatus status, MouseEventArgs e)
    {
        if (_isMobile) return; // mobile uses the info button (tap), not hover
        _popupUser = user;
        _popupStatus = status;
        _popupX = (int)e.ClientX;
        _popupY = (int)e.ClientY;
    }

    private void HideProfile() => _popupUser = null;

    // Mobile: tap the info button to toggle the centered profile card.
    private void ToggleProfile(string user, UserStatus status, MouseEventArgs e)
    {
        if (_popupUser == user)
        {
            _popupUser = null;
            return;
        }
        _popupUser = user;
        _popupStatus = status;
        _popupX = (int)e.ClientX;
        _popupY = (int)e.ClientY;
    }

    // Anchors the card to the left of the cursor (sidebar sits on the right edge).
    // clamp() keeps it inside the viewport without needing JS measurements; the mobile
    // ".is-mobile" rule overrides these to center the card instead.
    private string PopupStyle =>
        $"left: clamp(8px, {_popupX - 292}px, calc(100vw - 288px)); " +
        $"top: clamp(8px, {_popupY - 56}px, calc(100dvh - 348px));";

    #endregion

    private void RefreshOnlineUsers()
    {
        // Get all users with status - invisible users show with gray dot
        onlineUsers = ChatService.GetAllUsersWithStatus();
    }

    private bool HasUnreadInRoom(Guid roomId)
    {
        if (UserId == Guid.Empty) return false;
        return ChatService.HasUnreadInRoom(UserId, roomId);
    }

    private int GetUnreadDMCountForUser(string otherUsername)
    {
        // Safety check - user must be logged in
        if (UserId == Guid.Empty || string.IsNullOrEmpty(Username))
            return 0;

        // If we're currently viewing this DM, don't show unread
        if (NavState.CurrentDmUser?.Equals(otherUsername, StringComparison.OrdinalIgnoreCase) == true)
            return 0;

        try
        {
            var otherUser = UserService.GetByUsername(otherUsername);
            if (otherUser == null) return 0;

            // Find the DM channel between current user and other user
            var channels = ChatService.GetDMChannels(Username);
            var dmChannel = channels.FirstOrDefault(c => c.IsDMBetween(Username, otherUsername));
            if (dmChannel == null) return 0;

            return ChatService.GetUnreadCount(UserId, dmChannel.Id);
        }
        catch (Exception)
        {
            return 0;
        }
    }

    #region Event Handlers

    private async void HandleChannelCreated(Channel channel)
    {
        if (channel.Type == ChannelType.Room)
        {
            try
            {
                await InvokeAsync(() =>
                {
                    rooms = ChatService.GetRooms();
                    StateHasChanged();
                });
            }
            catch (Exception ex)
            {
                if (ex is ObjectDisposedException or InvalidOperationException)
                    Logger.LogWarning("HandleChannelCreated: {Message}", ex.Message);
                else
                    Logger.LogError(ex, "Error in HandleChannelCreated");
            }
        }
    }

    private async void HandleChannelDeleted(Guid channelId)
    {
        try
        {
            await InvokeAsync(() =>
            {
                rooms = ChatService.GetRooms();
                StateHasChanged();
            });
        }
        catch (Exception ex)
        {
            if (ex is ObjectDisposedException or InvalidOperationException)
                Logger.LogWarning("HandleChannelDeleted: {Message}", ex.Message);
            else
                Logger.LogError(ex, "Error in HandleChannelDeleted");
        }
    }

    private async void HandleChannelUpdated(Channel channel)
    {
        if (channel.Type == ChannelType.Room)
        {
            try
            {
                await InvokeAsync(() =>
                {
                    rooms = ChatService.GetRooms();
                    StateHasChanged();
                });
            }
            catch (Exception ex)
            {
                if (ex is ObjectDisposedException or InvalidOperationException)
                    Logger.LogWarning("HandleChannelUpdated: {Message}", ex.Message);
                else
                    Logger.LogError(ex, "Error in HandleChannelUpdated");
            }
        }
    }

    private async void HandleUsersListChanged()
    {
        try
        {
            await InvokeAsync(() =>
            {
                RefreshOnlineUsers();
                UpdateOnlineUsersHeader();
                StateHasChanged();
            });
        }
        catch (Exception ex)
        {
            if (ex is ObjectDisposedException or InvalidOperationException)
                Logger.LogWarning("HandleUsersListChanged: {Message}", ex.Message);
            else
                Logger.LogError(ex, "Error in HandleUsersListChanged");
        }
    }

    private async void HandleUserStatusChanged(string username, UserStatus status)
    {
        try
        {
            await InvokeAsync(() =>
            {
                RefreshOnlineUsers();
                StateHasChanged();
            });
        }
        catch (Exception ex)
        {
            if (ex is ObjectDisposedException or InvalidOperationException)
                Logger.LogWarning("HandleUserStatusChanged: {Message}", ex.Message);
            else
                Logger.LogError(ex, "Error in HandleUserStatusChanged");
        }
    }

    private async void HandleUnreadChanged(Guid userId, Guid channelId)
    {
        // Only refresh if the unread change is for the current user
        if (userId == UserId)
        {
            try
            {
                await InvokeAsync(StateHasChanged);
            }
            catch (Exception ex)
            {
                if (ex is ObjectDisposedException or InvalidOperationException)
                    Logger.LogWarning("HandleUnreadChanged: {Message}", ex.Message);
                else
                    Logger.LogError(ex, "Error in HandleUnreadChanged");
            }
        }
    }

    #endregion

    #region Room Management

    private void SwitchToRoom(Guid roomId)
    {
        _popupUser = null; // dismiss any open profile card
        var url = roomId == ChatService.GetLobbyId() ? "/lobby" : $"/room/{roomId}";
        Navigation.NavigateTo(url);
    }

    private void NavigateToCreateRoom()
    {
        Navigation.NavigateTo("/channel/new");
    }

    private void OpenChannelSettings(Guid roomId)
    {
        Navigation.NavigateTo($"/channel/{roomId}/settings");
    }

    #endregion

    #region DM Management

    private void OpenDM(string targetUser)
    {
        _popupUser = null; // dismiss any open profile card
        if (targetUser.Equals(Username, StringComparison.OrdinalIgnoreCase)) return;

        Navigation.NavigateTo($"/dm/{Uri.EscapeDataString(targetUser)}");
    }

    private int GetUnreadDMCount(string fromUser)
    {
        return GetUnreadDMCountForUser(fromUser);
    }

    private IEnumerable<(string Username, UserStatus Status, bool? IsMobile)> GetSortedUsersWithStatus()
    {
        // Merge online users with offline DM partners
        var onlineUsersByName = onlineUsers.ToDictionary(u => u.Username, StringComparer.OrdinalIgnoreCase);

        // FUTURE: To show ALL known users instead of just DM contacts,
        // replace GetDMConversations() with UserService.GetAllUsernames()
        var dmPartners = ChatService.GetDMConversations(Username);

        var allUsers = new List<(string Username, UserStatus Status, bool? IsMobile)>(onlineUsers);

        // Add DM partners who are offline (shown as Invisible - same gray dot)
        foreach (var partner in dmPartners)
        {
            if (!onlineUsersByName.ContainsKey(partner))
            {
                allUsers.Add((partner, UserStatus.Invisible, null));
            }
        }

        var adminEntry = allUsers
            .Where(u => ChatService.IsAdmin(u.Username));
        var botEntry = allUsers
            .Where(u => BotService.IsBotUser(u.Username) && !ChatService.IsAdmin(u.Username));
        var currentUserEntry = allUsers
            .Where(u => u.Username.Equals(Username, StringComparison.OrdinalIgnoreCase) && !ChatService.IsAdmin(u.Username) && !BotService.IsBotUser(u.Username));
        var otherUsers = allUsers
            .Where(u => !u.Username.Equals(Username, StringComparison.OrdinalIgnoreCase) && !ChatService.IsAdmin(u.Username) && !BotService.IsBotUser(u.Username))
            .ToList();

        var sorted = otherUsers
            .Select(u => new
            {
                Entry = u,
                HasUnread = GetUnreadDMCount(u.Username) > 0,
                IsOnline = u.Status != UserStatus.Invisible
            })
            .OrderByDescending(x => x.HasUnread)
            .ThenByDescending(x => x.IsOnline)
            .ThenBy(x => x.Entry.Username, StringComparer.OrdinalIgnoreCase)
            .Select(x => x.Entry);

        return adminEntry.Concat(botEntry).Concat(currentUserEntry).Concat(sorted);
    }

    #endregion

    #region Helpers

    private void UpdateOnlineUsersHeader()
    {
        onlineUsersHeader = ChatConfig.GetRandomOnlineUsersHeader(onlineUsers.Count);
    }

    private string GetDisplayName(string username)
    {
        var user = UserService.GetByUsername(username);
        return user?.EffectiveDisplayName ?? username;
    }

    #endregion

    public void Dispose()
    {
        ChatService.OnChannelCreated -= HandleChannelCreated;
        ChatService.OnChannelUpdated -= HandleChannelUpdated;
        ChatService.OnChannelDeleted -= HandleChannelDeleted;
        ChatService.OnUsersListChanged -= HandleUsersListChanged;
        ChatService.OnUserStatusChanged -= HandleUserStatusChanged;
        ChatService.OnUnreadChanged -= HandleUnreadChanged;
        NavState.OnChange -= StateHasChanged;
    }
}

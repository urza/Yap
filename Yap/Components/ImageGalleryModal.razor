@using Yap.Services
@inject IJSRuntime JS
@implements IAsyncDisposable

@if (Visible && TotalCount > 0)
{
    <div class="image-modal" @onclick="Close">
        @if (TotalCount > 1)
        {
            <button class="modal-nav prev" @onclick="PrevItem" @onclick:stopPropagation="true" title="Previous">‹</button>
        }

        @if (IsCurrentVideo)
        {
            <video class="modal-video" controls autoplay @onclick:stopPropagation="true">
                <source src="@VideoService.GetCompressedUrl(CurrentUrl)" type="video/mp4" />
                <source src="@CurrentUrl" />
            </video>
        }
        else
        {
            <img src="@ImageService.GetLargeUrl(CurrentUrl)"
                 onerror="this.onerror=null; this.src='@ImageService.GetMediumUrl(CurrentUrl)'"
                 alt="Full size image" @onclick:stopPropagation="true" />
        }

        @if (TotalCount > 1)
        {
            <button class="modal-nav next" @onclick="NextItem" @onclick:stopPropagation="true" title="Next">›</button>
            <div class="modal-counter">@(currentIndex + 1) / @TotalCount</div>
        }
        <button class="modal-close" @onclick="Close" @onclick:stopPropagation="true" title="Close">×</button>
    </div>
}

@code {
    private int currentIndex = 0;
    private DotNetObjectReference<ImageGalleryModal>? dotNetRef;

    [Parameter] public bool Visible { get; set; }
    [Parameter] public List<string> Images { get; set; } = new();
    [Parameter] public List<string> Videos { get; set; } = new();
    [Parameter] public int StartIndex { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>
    /// Combined media items: images first, then videos.
    /// </summary>
    private int TotalCount => Images.Count + Videos.Count;

    private string CurrentUrl => currentIndex < Images.Count
        ? Images[currentIndex]
        : Videos[currentIndex - Images.Count];

    private bool IsCurrentVideo => currentIndex >= Images.Count;

    protected override async Task OnParametersSetAsync()
    {
        if (Visible && TotalCount > 0)
        {
            currentIndex = Math.Min(StartIndex, TotalCount - 1);
            await SetupKeyboard();
        }
    }

    private async Task SetupKeyboard()
    {
        dotNetRef?.Dispose();
        dotNetRef = DotNetObjectReference.Create(this);
        try { await JS.InvokeVoidAsync("setupModalKeyboard", dotNetRef); }
        catch (Exception ex) { Console.WriteLine($"[ImageGalleryModal] Failed to setup keyboard: {ex.Message}"); }
    }

    private async Task RemoveKeyboard()
    {
        try { await JS.InvokeVoidAsync("removeModalKeyboard"); }
        catch (Exception ex) { Console.WriteLine($"[ImageGalleryModal] Failed to remove keyboard: {ex.Message}"); }
        dotNetRef?.Dispose();
        dotNetRef = null;
    }

    private async Task Close()
    {
        await RemoveKeyboard();
        await OnClose.InvokeAsync();
    }

    private void NextItem()
    {
        if (TotalCount > 0)
            currentIndex = (currentIndex + 1) % TotalCount;
    }

    private void PrevItem()
    {
        if (TotalCount > 0)
            currentIndex = (currentIndex - 1 + TotalCount) % TotalCount;
    }

    [JSInvokable]
    public async Task CloseModalFromJs()
    {
        await InvokeAsync(async () => { await Close(); StateHasChanged(); });
    }

    [JSInvokable]
    public void NextImageFromJs() => InvokeAsync(() => { NextItem(); StateHasChanged(); });

    [JSInvokable]
    public void PrevImageFromJs() => InvokeAsync(() => { PrevItem(); StateHasChanged(); });

    public async ValueTask DisposeAsync()
    {
        await RemoveKeyboard();
    }
}

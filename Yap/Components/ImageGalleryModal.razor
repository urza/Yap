@using Yap.Services
@inject IJSRuntime JS
@implements IAsyncDisposable

@if (Visible && TotalCount > 0)
{
    @* Every item is rendered up front and the browser does the swiping (scroll-snap on the strip),
       so a swipe never waits for the circuit. chat.js owns everything the finger does: it scrolls
       the strip to data-start before the first paint, keeps the counter and video play state,
       toggles "fill" on a stage, "dragging"/"closing" for drag-to-close. The class attributes below
       are STATIC on purpose: Blazor never re-renders them, so the classes JS adds can't be clobbered.
       The circuit only learns about one thing: closing. *@
    <div class="image-modal" @onclick="Close">
        <div class="gallery-strip" data-start="@Start">
            @for (var i = 0; i < Images.Count; i++)
            {
                <div class="modal-stage">
                    <img src="@ImageService.GetLargeUrl(Images[i])"
                         loading="@(i == Start ? "eager" : "lazy")"
                         onerror="this.onerror=null; this.src='@ImageService.GetMediumUrl(Images[i])'"
                         alt="Full size image" draggable="false" @onclick:stopPropagation="true" />
                </div>
            }
            @foreach (var url in Videos)
            {
                <div class="modal-stage">
                    @* No autoplay: chat.js plays the video whose stage is in view and pauses the rest. *@
                    <video class="modal-video" controls preload="metadata" @onclick:stopPropagation="true">
                        <source src="@VideoService.GetCompressedUrl(url)" type="video/mp4" />
                        <source src="@url" />
                    </video>
                </div>
            }
        </div>

        @if (TotalCount > 1)
        {
            @* Plain buttons: chat.js scrolls the strip. stopPropagation keeps the tap off the backdrop close. *@
            <button class="modal-nav prev" @onclick:stopPropagation="true" title="Previous">‹</button>
            <button class="modal-nav next" @onclick:stopPropagation="true" title="Next">›</button>
            <div class="modal-counter"><span class="modal-counter-index">@(Start + 1)</span> / @TotalCount</div>
        }
        @if (Images.Count > 0)
        {
            <button class="modal-fill" @onclick:stopPropagation="true" title="Fill screen"></button>
        }
        <button class="modal-close" @onclick="Close" @onclick:stopPropagation="true" title="Close">×</button>
    </div>
}

@code {
    private DotNetObjectReference<ImageGalleryModal>? dotNetRef;
    private bool attached;

    [Parameter] public bool Visible { get; set; }
    [Parameter] public List<string> Images { get; set; } = new();
    [Parameter] public List<string> Videos { get; set; } = new();
    [Parameter] public int StartIndex { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>Combined media items: images first, then videos.</summary>
    private int TotalCount => Images.Count + Videos.Count;

    private int Start => Math.Clamp(StartIndex, 0, TotalCount - 1);

    protected override async Task OnParametersSetAsync()
    {
        var open = Visible && TotalCount > 0;
        if (open && !attached) await Attach();
        else if (!open && attached) await Detach();
    }

    /// <summary>Gives chat.js the keyboard handler and a way to close the modal from a gesture.</summary>
    private async Task Attach()
    {
        dotNetRef?.Dispose();
        dotNetRef = DotNetObjectReference.Create(this);
        try
        {
            await JS.InvokeVoidAsync("attachGalleryModal", dotNetRef);
            attached = true;
        }
        catch (Exception ex) { Console.WriteLine($"[ImageGalleryModal] Failed to attach: {ex.Message}"); }
    }

    private async Task Detach()
    {
        attached = false;
        try { await JS.InvokeVoidAsync("detachGalleryModal"); }
        catch (Exception ex) { Console.WriteLine($"[ImageGalleryModal] Failed to detach: {ex.Message}"); }
        dotNetRef?.Dispose();
        dotNetRef = null;
    }

    private async Task Close()
    {
        await Detach();
        await OnClose.InvokeAsync();
    }

    [JSInvokable]
    public async Task CloseModalFromJs()
    {
        await InvokeAsync(async () => { await Close(); StateHasChanged(); });
    }

    public async ValueTask DisposeAsync()
    {
        if (attached) await Detach();
    }
}

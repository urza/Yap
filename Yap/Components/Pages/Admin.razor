@page "/admin"
@inject UserStateService UserState
@inject UserService UserService
@inject ChatService ChatService
@inject UserActionLogService ActionLog
@inject PushSubscriptionStore PushStore
@inject GeoLocationService GeoLocation
@inject SystemBotService BotService
@inject RegistrationGateService RegistrationGate
@inject NavigationManager Navigation

<PageTitle>Admin</PageTitle>

<div class="admin-page">
    <nav class="admin-sidebar">
        <div class="admin-sidebar-header">
            <button class="back-button" @onclick="GoBack" title="Go back">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/>
                </svg>
            </button>
            <h2>Admin</h2>
        </div>
        <button class="nav-item @(activeSection == "users" ? "active" : "")"
                @onclick='() => activeSection = "users"'>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M14 8.00598C14 10.211 12.206 12.006 10 12.006C7.795 12.006 6 10.211 6 8.00598C6 5.80098 7.795 4.00598 10 4.00598C12.206 4.00598 14 5.80098 14 8.00598ZM2 19.006C2 15.473 5.29 13.006 10 13.006C14.711 13.006 18 15.473 18 19.006V20.006H2V19.006Z"/>
                <path d="M20.0001 20.006H22.0001V19.006C22.0001 16.4433 20.2697 14.4415 17.5213 13.5352C19.0621 14.9127 20.0001 16.8059 20.0001 19.006V20.006Z"/>
                <path d="M14.8834 11.9077C16.6657 11.5044 18.0001 9.9077 18.0001 8.00598C18.0001 5.96916 16.4693 4.28218 14.4971 4.0367C15.4322 5.09511 16.0001 6.48524 16.0001 8.00598C16.0001 9.44888 15.4889 10.7742 14.6378 11.8102C14.7203 11.8734 14.8022 11.9388 14.8834 11.9077Z"/>
            </svg>
            <span>Users</span>
        </button>
        <button class="nav-item @(activeSection == "debug" ? "active" : "")"
                @onclick='() => activeSection = "debug"'>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M20 8h-2.81c-.45-.78-1.07-1.45-1.82-1.96L17 4.41 15.59 3l-2.17 2.17C12.96 5.06 12.49 5 12 5s-.96.06-1.41.17L8.41 3 7 4.41l1.62 1.63C7.88 6.55 7.26 7.22 6.81 8H4v2h2.09c-.05.33-.09.66-.09 1v1H4v2h2v1c0 .34.04.67.09 1H4v2h2.81c1.04 1.79 2.97 3 5.19 3s4.15-1.21 5.19-3H20v-2h-2.09c.05-.33.09-.66.09-1v-1h2v-2h-2v-1c0-.34-.04-.67-.09-1H20V8zm-6 8h-4v-2h4v2zm0-4h-4v-2h4v2z"/>
            </svg>
            <span>Debug</span>
        </button>
        <button class="nav-item @(activeSection == "bot" ? "active" : "")"
                @onclick='() => activeSection = "bot"'>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2a2 2 0 0 1 2 2c0 .74-.4 1.39-1 1.73V7h1a7 7 0 0 1 7 7h1a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-1.17A7 7 0 0 1 14 22h-4a7 7 0 0 1-6.83-3H2a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1h1a7 7 0 0 1 7-7h1V5.73c-.6-.34-1-.99-1-1.73a2 2 0 0 1 2-2zM9.5 13a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3zm5 0a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3z"/>
            </svg>
            <span>Bot</span>
        </button>
        <button class="nav-item @(activeSection == "settings" ? "active" : "")"
                @onclick='() => activeSection = "settings"'>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58a.49.49 0 0 0 .12-.61l-1.92-3.32a.49.49 0 0 0-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54a.484.484 0 0 0-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96a.49.49 0 0 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.07.62-.07.94s.02.64.07.94l-2.03 1.58a.49.49 0 0 0-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6A3.6 3.6 0 1 1 12 8.4a3.6 3.6 0 0 1 0 7.2z"/>
            </svg>
            <span>Settings</span>
        </button>
        <button class="nav-item @(activeSection == "logs" ? "active" : "")"
                @onclick="SelectLogsTab">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm-1 9h-2v2H9v-2H7v-2h2V7h2v2h2v2zm-3 8H8v-6h2v6zm4 0h-2v-4h2v4zm4 0h-2v-8h2v8zm-2-14V3.5L18.5 9H13z"/>
            </svg>
            <span>Logs</span>
        </button>
    </nav>

    <div class="admin-tabs">
        <button class="tab-item @(activeSection == "users" ? "active" : "")"
                @onclick='() => activeSection = "users"'>
            Users
        </button>
        <button class="tab-item @(activeSection == "debug" ? "active" : "")"
                @onclick='() => activeSection = "debug"'>
            Debug
        </button>
        <button class="tab-item @(activeSection == "bot" ? "active" : "")"
                @onclick='() => activeSection = "bot"'>
            Bot
        </button>
        <button class="tab-item @(activeSection == "settings" ? "active" : "")"
                @onclick='() => activeSection = "settings"'>
            Settings
        </button>
        <button class="tab-item @(activeSection == "logs" ? "active" : "")"
                @onclick="SelectLogsTab">
            Logs
        </button>
    </div>

    <main class="admin-content">
        @if (activeSection == "users")
        {
            <div class="section-header">
                <h3>Users</h3>
                <span class="section-count">@users.Count registered</span>
            </div>

            <div class="table-wrapper">
                <table class="users-table">
                    <thead>
                        <tr>
                            <th>User</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th>Last Action</th>
                            <th>Locale</th>
                            <th>Recent IPs</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in users)
                        {
                            var isOnline = onlineStatusMap.TryGetValue(user.Username, out var statusInfo);
                            var statusClass = isOnline ? statusInfo.Status.ToString().ToLower() : "offline";
                            var statusLabel = isOnline ? statusInfo.Status.ToString() : "Offline";
                            lastActions.TryGetValue(user.Id.ToString(), out var lastAction);
                            recentIPs.TryGetValue(user.Id.ToString(), out var ips);
                            var uid = user.Id;

                            <tr class="clickable-row @(selectedUserId == uid ? "selected" : "")"
                                @onclick="() => SelectUser(uid)">
                                <td class="user-cell">
                                    <Avatar Username="@user.Username"
                                            ProfilePictureUrl="@user.ProfilePictureUrl"
                                            Size="AvatarSize.Small" />
                                    <div class="user-info">
                                        <span class="user-name">
                                            @user.EffectiveDisplayName
                                            @if (user.IsAdmin)
                                            {
                                                <span class="admin-badge" title="Admin">&#x1F451;</span>
                                            }
                                        </span>
                                        @if (user.DisplayName != null)
                                        {
                                            <span class="user-username">@user.Username</span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <span class="status-pill @statusClass">
                                        <span class="status-dot"></span>
                                        @statusLabel
                                    </span>
                                </td>
                                <td class="date-cell">@user.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="action-cell">
                                    @if (lastAction != null)
                                    {
                                        <span class="action-type">@lastAction.Action</span>
                                        <span class="action-date">@lastAction.Date.ToString("yyyy-MM-dd HH:mm")</span>
                                    }
                                    else
                                    {
                                        <span class="no-data">—</span>
                                    }
                                </td>
                                <td class="locale-cell">
                                    @if (user.TimeZone != null)
                                    {
                                        <span class="locale-tz" title="@user.TimeZone">@user.TimeZone</span>
                                        <span class="locale-lang">@user.Locale</span>
                                    }
                                    else
                                    {
                                        <span class="no-data">—</span>
                                    }
                                </td>
                                <td class="ip-cell">
                                    @if (ips != null && ips.Count > 0)
                                    {
                                        @foreach (var ip in ips)
                                        {
                                            var geo = GeoLocation.IsAvailable ? GeoLocation.Lookup(ip)?.ToString() : null;
                                            <span class="ip-tag" title="@(geo ?? "")">@ip</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="no-data">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (selectedUser != null)
            {
                <div class="user-detail-panel">
                    <div class="detail-header">
                        <Avatar Username="@selectedUser.Username"
                                ProfilePictureUrl="@selectedUser.ProfilePictureUrl"
                                Size="AvatarSize.Medium" />
                        <div class="detail-header-info">
                            <h4>@selectedUser.EffectiveDisplayName</h4>
                            @if (selectedUser.DisplayName != null)
                            {
                                <span class="user-username">@selectedUser.Username</span>
                            }
                        </div>
                        <button class="detail-close" @onclick="() => selectedUserId = null" title="Close">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
                            </svg>
                        </button>
                    </div>

                    @if (loadingDetail)
                    {
                        <div class="detail-loading">Loading...</div>
                    }
                    else
                    {
                        <div class="detail-tags">
                            <span class="detail-tag @(detailPushSubCount > 0 ? "tag-green" : "tag-muted")">
                                @if (detailPushSubCount > 0)
                                {
                                    <span>Push @detailPushSubCount sub@(detailPushSubCount != 1 ? "s" : "")</span>
                                }
                                else
                                {
                                    <span>No push</span>
                                }
                            </span>
                            @if (selectedUser!.PushMuted)
                            {
                                <span class="detail-tag tag-orange">Muted</span>
                            }
                        </div>

                        <div class="detail-tables">
                            <div class="detail-section">
                                <h5>IP Addresses</h5>
                                @if (detailIPs.Count > 0)
                                {
                                    <table class="detail-table">
                                        <thead>
                                            <tr>
                                                <th>IP Address</th>
                                                @if (GeoLocation.IsAvailable)
                                                {
                                                    <th>Location</th>
                                                }
                                                <th>Last Seen</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var (ip, lastSeen) in detailIPs)
                                            {
                                                <tr>
                                                    <td class="ip-mono">@ip</td>
                                                    @if (GeoLocation.IsAvailable)
                                                    {
                                                        var geoDetail = GeoLocation.Lookup(ip);
                                                        <td class="geo-cell">@(geoDetail?.ToString() ?? "—")</td>
                                                    }
                                                    <td class="date-cell">@lastSeen.ToString("yyyy-MM-dd HH:mm")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                                else
                                {
                                    <span class="no-data">No IP data</span>
                                }
                            </div>

                            <div class="detail-section">
                                <h5>User Agents</h5>
                                @if (detailUserAgents.Count > 0)
                                {
                                    <table class="detail-table">
                                        <thead>
                                            <tr>
                                                <th>User Agent</th>
                                                <th>Last Seen</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var (ua, lastSeen) in detailUserAgents)
                                            {
                                                <tr>
                                                    <td class="ua-cell">@ua</td>
                                                    <td class="date-cell">@lastSeen.ToString("yyyy-MM-dd HH:mm")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                                else
                                {
                                    <span class="no-data">No user agent data</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        }

        @if (activeSection == "debug")
        {
            <div class="section-header">
                <h3>Message Generator</h3>
                <span class="section-count">Generate test messages for debugging</span>
            </div>

            <div class="debug-form">
                <div class="form-group">
                    <label>Channel</label>
                    <select @bind="debugChannelId">
                        @foreach (var room in ChatService.GetRooms())
                        {
                            <option value="@room.Id">@room.Name</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label>Number of messages</label>
                    <input type="number" @bind="debugMessageCount" min="1" max="5000" />
                </div>

                <div class="form-group">
                    <label>Spread across</label>
                    <select @bind="debugTimeSpan">
                        <option value="1">Last 1 hour</option>
                        <option value="6">Last 6 hours</option>
                        <option value="24">Last 1 day</option>
                        <option value="72">Last 3 days</option>
                        <option value="168">Last 1 week</option>
                        <option value="336">Last 2 weeks</option>
                        <option value="720">Last 1 month</option>
                        <option value="2160">Last 3 months</option>
                        <option value="8760">Last 1 year</option>
                    </select>
                </div>

                <button class="generate-btn" @onclick="GenerateMessages" disabled="@debugGenerating">
                    @if (debugGenerating)
                    {
                        <span>Generating...</span>
                    }
                    else
                    {
                        <span>Generate @debugMessageCount messages</span>
                    }
                </button>

                @if (debugResult != null)
                {
                    <div class="debug-result">@debugResult</div>
                }
            </div>
        }
        @if (activeSection == "bot")
        {
            <div class="section-header">
                <h3>Bot Settings</h3>
                <span class="section-count">System bot configuration</span>
            </div>

            <div class="bot-settings">
                <div class="form-group">
                    <label>Username</label>
                    <input type="text" value="@botUsername" disabled class="form-input disabled" />
                    <span class="form-hint">Username cannot be changed after creation</span>
                </div>

                <div class="form-group">
                    <label>Display Name</label>
                    <input type="text" @bind="botDisplayName" class="form-input" maxlength="32" />
                </div>

                <div class="form-group">
                    <label>Welcome Message</label>
                    <textarea @bind="botWelcomeMessage" class="form-input form-textarea" rows="3" maxlength="500"></textarea>
                    <span class="form-hint">Sent to new users as a DM. Use {0} for the server name. Mobile users also get a PWA install link.</span>
                </div>

                <div class="bot-actions">
                    <button class="save-btn" @onclick="SaveBotSettings" disabled="@botSaving">
                        @(botSaving ? "Saving..." : "Save")
                    </button>
                    @if (botSaveResult != null)
                    {
                        <span class="save-result">@botSaveResult</span>
                    }
                </div>
            </div>
        }
        @if (activeSection == "settings")
        {
            <div class="section-header">
                <h3>Registration</h3>
                <span class="section-count">Control who can join</span>
            </div>

            <div class="registration-settings">
                <label class="toggle-row">
                    <div class="toggle-info">
                        <span class="toggle-label">Close registration</span>
                        <span class="toggle-hint">Block all new signups. Login page shows "temporarily closed".</span>
                    </div>
                    <label class="toggle-switch">
                        <input type="checkbox" checked="@regClosed" @onchange="ToggleRegistrationClosed" />
                        <span class="toggle-slider"></span>
                    </label>
                </label>

                <label class="toggle-row">
                    <div class="toggle-info">
                        <span class="toggle-label">Require approval</span>
                        <span class="toggle-hint">New users must wait for admin approval before joining.</span>
                    </div>
                    <label class="toggle-switch">
                        <input type="checkbox" checked="@regApproval" @onchange="ToggleRequireApproval" />
                        <span class="toggle-slider"></span>
                    </label>
                </label>

                <label class="toggle-row">
                    <div class="toggle-info">
                        <span class="toggle-label">Smart login</span>
                        <span class="toggle-hint">Auto-login returning users from the same IP address without passphrase.</span>
                    </div>
                    <label class="toggle-switch">
                        <input type="checkbox" checked="@smartMode" @onchange="ToggleSmartMode" />
                        <span class="toggle-slider"></span>
                    </label>
                </label>
            </div>

            @if (pendingUsersList.Count > 0)
            {
                <div class="section-header" style="margin-top: 2rem;">
                    <h3>Pending Requests</h3>
                    <span class="section-count">@pendingUsersList.Count waiting</span>
                    <button class="refresh-btn" @onclick="RefreshPending" title="Refresh">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M17.65 6.35A7.958 7.958 0 0 0 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0 1 12 18c-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"/>
                        </svg>
                    </button>
                </div>

                <div class="pending-list">
                    @foreach (var (username, requestedAt) in pendingUsersList)
                    {
                        var u = username;
                        <div class="pending-item">
                            <div class="pending-info">
                                <span class="pending-username">@u</span>
                                <span class="pending-time">@FormatTimeAgo(requestedAt)</span>
                            </div>
                            <div class="pending-actions">
                                <button class="approve-btn" @onclick="() => ApprovePending(u)">Approve</button>
                                <button class="reject-btn" @onclick="() => RejectPending(u)">Reject</button>
                            </div>
                        </div>
                    }
                </div>
            }
        }

        @if (activeSection == "logs")
        {
            <div class="section-header">
                <h3>Action Logs</h3>
                <span class="section-count">@logEntries.Count loaded</span>
            </div>

            <div class="log-filters">
                <select class="log-filter-select" @onchange="OnActionFilterChanged">
                    <option value="">All actions</option>
                    <option value="LOGIN" selected="@(logFilterAction == "LOGIN")">LOGIN</option>
                    <option value="LOGOUT" selected="@(logFilterAction == "LOGOUT")">LOGOUT</option>
                    <option value="SMART_LOGIN" selected="@(logFilterAction == "SMART_LOGIN")">SMART_LOGIN</option>
                    <option value="CIRCUIT_RECONNECT" selected="@(logFilterAction == "CIRCUIT_RECONNECT")">CIRCUIT_RECONNECT</option>
                    <option value="CIRCUIT_DISCONNECT" selected="@(logFilterAction == "CIRCUIT_DISCONNECT")">CIRCUIT_DISCONNECT</option>
                </select>
                <input type="text" class="log-filter-input" placeholder="Filter by username..."
                       @bind="logFilterUsername" @bind:event="oninput" @bind:after="OnUsernameFilterChanged" />
            </div>

            <div class="table-wrapper">
                <table class="users-table logs-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>User</th>
                            <th>Action</th>
                            <th>IP</th>
                            <th>Info</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in logEntries)
                        {
                            <tr>
                                <td class="date-cell">@FormatLogDate(entry.Date)</td>
                                <td>@ResolveUsername(entry.UserUid)</td>
                                <td><span class="action-pill @GetActionClass(entry.Action)">@entry.Action</span></td>
                                <td class="ip-mono">@(entry.IP ?? "-")</td>
                                <td class="info-cell">@(entry.Info ?? "-")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (logEntries.Count > 0 && logEntries.Count % 100 == 0)
            {
                <div class="log-load-more">
                    <button class="upload-button" @onclick="LoadMoreLogs" disabled="@logLoading">
                        @(logLoading ? "Loading..." : "Load more")
                    </button>
                </div>
            }

            @if (!logLoading && logEntries.Count == 0)
            {
                <div class="log-empty">No log entries found.</div>
            }
        }
    </main>
</div>

@code {
    private string activeSection = "users";

    private List<User> users = new();
    private Dictionary<string, (UserStatus Status, bool? IsMobile)> onlineStatusMap = new();
    private Dictionary<string, UserActionLog> lastActions = new();
    private Dictionary<string, List<string>> recentIPs = new();

    // User detail panel
    private Guid? selectedUserId;
    private bool loadingDetail;
    private int detailPushSubCount;
    private List<(string IP, DateTime LastSeen)> detailIPs = new();
    private List<(string UserAgent, DateTime LastSeen)> detailUserAgents = new();

    private User? selectedUser => selectedUserId.HasValue
        ? users.FirstOrDefault(u => u.Id == selectedUserId.Value)
        : null;

    protected override void OnInitialized()
    {
        // Auth + admin guard
        if (!UserState.IsLoggedIn || !UserState.UserId.HasValue || !UserService.IsAdmin(UserState.UserId.Value))
        {
            Navigation.NavigateTo("/lobby");
            return;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!UserState.IsLoggedIn || !UserState.UserId.HasValue || !UserService.IsAdmin(UserState.UserId.Value))
            return;

        // Load users from UserService
        users = UserService.GetAllUsers().OrderBy(u => u.CreatedAt).ToList();

        // Build online status map from ChatService
        var onlineUsers = ChatService.GetAllUsersWithStatus();
        onlineStatusMap = onlineUsers.ToDictionary(
            u => u.Username,
            u => (u.Status, u.IsMobile),
            StringComparer.OrdinalIgnoreCase);

        // Load action logs and IPs in parallel
        var lastActionsTask = ActionLog.GetLastActionPerUserAsync();
        var recentIPsTask = ActionLog.GetRecentIPsPerUserAsync();

        await Task.WhenAll(lastActionsTask, recentIPsTask);

        lastActions = lastActionsTask.Result;
        recentIPs = recentIPsTask.Result;

        // Default debug channel to first room
        var rooms = ChatService.GetRooms();
        if (rooms.Count > 0)
            debugChannelId = rooms[0].Id;

        // Load bot settings
        botUsername = BotService.BotUsername ?? "";
        var botUser = BotService.BotUserId.HasValue ? UserService.GetById(BotService.BotUserId.Value) : null;
        botDisplayName = botUser?.DisplayName ?? botUsername;
        botWelcomeMessage = BotService.WelcomeMessage;

        // Load registration settings
        regClosed = RegistrationGate.RegistrationClosed;
        regApproval = RegistrationGate.RequireApproval;
        smartMode = RegistrationGate.SmartMode;
        pendingUsersList = RegistrationGate.GetPendingUsers();
    }

    private async Task SelectUser(Guid userId)
    {
        if (selectedUserId == userId)
        {
            selectedUserId = null;
            return;
        }

        selectedUserId = userId;
        loadingDetail = true;

        var user = users.First(u => u.Id == userId);
        detailPushSubCount = PushStore.GetSubscriptions(user.Username).Count();

        var (ips, agents) = await ActionLog.GetUserConnectionDetailsAsync(userId.ToString());
        detailIPs = ips;
        detailUserAgents = agents;
        loadingDetail = false;
    }

    // Bot settings
    private string botUsername = "";
    private string botDisplayName = "";
    private string botWelcomeMessage = "";
    private bool botSaving;
    private string? botSaveResult;

    // Debug message generator
    private Guid debugChannelId;
    private int debugMessageCount = 200;
    private int debugTimeSpan = 168; // hours
    private bool debugGenerating;
    private string? debugResult;

    private async Task GenerateMessages()
    {
        if (!UserState.UserId.HasValue) return;

        debugGenerating = true;
        debugResult = null;
        StateHasChanged();

        try
        {
            var span = TimeSpan.FromHours(debugTimeSpan);
            var generated = await ChatService.GenerateTestMessagesAsync(
                debugChannelId, UserState.UserId.Value, UserState.Username!, debugMessageCount, span);
            debugResult = $"Generated {generated} messages spread across {span.TotalHours}h";
        }
        catch (Exception ex)
        {
            debugResult = $"Error: {ex.Message}";
        }
        finally
        {
            debugGenerating = false;
        }
    }

    private async Task SaveBotSettings()
    {
        botSaving = true;
        botSaveResult = null;
        StateHasChanged();

        try
        {
            await BotService.UpdateDisplayNameAsync(botDisplayName.Trim());
            await BotService.UpdateWelcomeMessageAsync(botWelcomeMessage.Trim());
            botSaveResult = "Saved!";
        }
        catch (Exception ex)
        {
            botSaveResult = $"Error: {ex.Message}";
        }
        finally
        {
            botSaving = false;
        }
    }


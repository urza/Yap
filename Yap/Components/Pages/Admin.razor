    // Logs tab
    private List<UserActionLog> logEntries = new();
    private string? logFilterAction;
    private string logFilterUsername = "";
    private bool logLoading;
    private bool logLoaded;
    private CancellationTokenSource? _logFilterCts;
    private Dictionary<string, string> _uidToUsername = new();

    private async Task SelectLogsTab()
    {
        activeSection = "logs";
        if (!logLoaded)
            await LoadLogs();
    }

    private async Task LoadLogs()
    {
        logLoading = true;
        StateHasChanged();

        string? userUid = null;
        if (!string.IsNullOrWhiteSpace(logFilterUsername))
        {
            var user = UserService.GetByUsername(logFilterUsername.Trim());
            userUid = user?.Id.ToString();
            if (user == null)
            {
                logEntries = new();
                logLoading = false;
                logLoaded = true;
                return;
            }
        }

        logEntries = await ActionLog.GetLogsAsync(userUid, logFilterAction, 0, 100);
        logLoading = false;
        logLoaded = true;
    }

    private async Task LoadMoreLogs()
    {
        logLoading = true;
        StateHasChanged();

        string? userUid = null;
        if (!string.IsNullOrWhiteSpace(logFilterUsername))
        {
            var user = UserService.GetByUsername(logFilterUsername.Trim());
            userUid = user?.Id.ToString();
        }

        var more = await ActionLog.GetLogsAsync(userUid, logFilterAction, logEntries.Count, 100);
        logEntries.AddRange(more);
        logLoading = false;
    }

    private async Task OnActionFilterChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        logFilterAction = string.IsNullOrEmpty(val) ? null : val;
        await LoadLogs();
    }

    private void OnUsernameFilterChanged()
    {
        _logFilterCts?.Cancel();
        _logFilterCts = new CancellationTokenSource();
        var token = _logFilterCts.Token;
        _ = Task.Delay(500, token).ContinueWith(async _ =>
        {
            if (!token.IsCancellationRequested)
                await InvokeAsync(async () => { await LoadLogs(); StateHasChanged(); });
        }, token);
    }

    private string ResolveUsername(string userUid)
    {
        if (_uidToUsername.TryGetValue(userUid, out var cached))
            return cached;

        if (Guid.TryParse(userUid, out var guid))
        {
            var user = UserService.GetById(guid);
            var name = user?.Username ?? userUid;
            _uidToUsername[userUid] = name;
            return name;
        }

        _uidToUsername[userUid] = userUid;
        return userUid;
    }

    private static string FormatLogDate(DateTime utcTime)
    {
        return utcTime.ToString("yyyy-MM-dd HH:mm:ss");
    }

    private static string GetActionClass(string action) => action switch
    {
        "LOGIN" => "action-login",
        "LOGOUT" => "action-logout",
        "SMART_LOGIN" => "action-smart",
        "CIRCUIT_RECONNECT" => "action-circuit",
        "CIRCUIT_DISCONNECT" => "action-circuit",
        _ => "action-default"
    };

    private static string FormatTimeAgo(DateTime utcTime)
    {
        var elapsed = DateTime.UtcNow - utcTime;
        if (elapsed.TotalSeconds < 60) return "just now";
        if (elapsed.TotalMinutes < 60) return $"{(int)elapsed.TotalMinutes}m ago";
        if (elapsed.TotalHours < 24) return $"{(int)elapsed.TotalHours}h ago";
        return $"{(int)elapsed.TotalDays}d ago";
    }


@page "/settings"
@layout ChatLayout
@inject UserStateService UserState
@inject UserService UserService
@inject ImageService ImageService
@inject ChatNavigationState NavState
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject PushSubscriptionStore PushStore
@inject PushNotificationService PushService
@inject GeoLocationService GeoLocation
@inject IHttpContextAccessor HttpContextAccessor
@inject ChatService ChatService
@inject RegistrationGateService RegistrationGate
@inject ILogger<Settings> Logger
@implements IAsyncDisposable

<PageTitle>Settings</PageTitle>

<div class="settings-container">
    @if (showKickedNotice)
    {
        <div class="kicked-notice">
            <span class="kicked-notice-icon">&#x1f512;</span>
            <div class="kicked-notice-text">
                <strong>All other devices have been signed out.</strong>
                Your secret code was automatically changed. See your new secret code below.
            </div>
            <button class="kicked-notice-dismiss" @onclick="() => showKickedNotice = false">&times;</button>
        </div>
    }

    <div class="settings-header">
        <h2>Settings</h2>
        @if (saveStatus != null)
        {
            <span class="save-status @(saveStatus == "Saved" ? "saved" : "saving")">@saveStatus</span>
        }
    </div>

    <div class="settings-content">
        <p class="form-hint" style="margin-bottom: 12px;">Changes are saved automatically.</p>
        <div class="settings-section">
            <h3>Profile</h3>

            <div class="profile-picture-section">
                <Avatar Username="@(UserState.Username ?? "")"
                        ProfilePictureUrl="@profilePictureUrl"
                        Size="AvatarSize.Large" />

                <div class="profile-picture-actions">
                    <InputFile OnChange="HandleProfilePictureUpload" accept="image/*" id="profile-upload" class="file-input" />
                    <label for="profile-upload" class="upload-button">
                        @if (isUploading)
                        {
                            <span>Uploading...</span>
                        }
                        else
                        {
                            <span>@(string.IsNullOrEmpty(profilePictureUrl) ? "Upload Picture" : "Change Picture")</span>
                        }
                    </label>
                    @if (!string.IsNullOrEmpty(profilePictureUrl))
                    {
                        <button class="remove-button" @onclick="RemoveProfilePicture" disabled="@isUploading">
                            Remove
                        </button>
                    }
                </div>
            </div>

            <div class="form-group">
                <label for="display-name">Display Name</label>
                <input type="text" id="display-name" value="@displayName"
                       @oninput="OnDisplayNameInput"
                       placeholder="@(UserState.Username ?? "Username")" maxlength="64" class="form-input" />
                <span class="form-hint">Your username is @UserState.Username, but your display name can be more fun. It can contain symbols and emojis :) </span>
            </div>

            <div class="form-group">
                <label for="bio">Bio</label>
                <textarea id="bio" value="@bio"
                          @oninput="OnBioInput" maxlength="150"
                          placeholder="Why are you awesome..." class="form-textarea"></textarea>
                <span class="form-counter">@(bio?.Length ?? 0)/150</span>
            </div>

            <div class="form-group">
                <label for="country">Tell us where are you from - map is in the making!</label>
                <div style="display: flex; gap: 8px; align-items: center;">
                    <input type="text" id="country" value="@country"
                           @oninput="OnCountryInput"
                           placeholder="London" maxlength="100" class="form-input" style="flex: 1;" />
                    @if (detectedLocation != null)
                    {
                        <button class="upload-button" @onclick="FillDetectedLocation" style="white-space: nowrap;">
                            Detect
                        </button>
                    }
                </div>
                <span class="form-hint">Your location — used for the user map</span>
            </div>
        </div>

        <div class="settings-section">
            <h3>Appearance</h3>
            <span class="form-hint" style="margin-bottom: 12px;">Pick a color theme. Changes apply instantly and sync across your devices.</span>
            <div class="theme-grid">
                @foreach (var theme in ThemeRegistry.All)
                {
                    var id = theme.Id;
                    <button type="button" class="theme-card @(selectedTheme == id ? "selected" : "")"
                            @onclick="() => SelectTheme(id)" title="@theme.Name">
                        <div class="theme-card-preview" style="background: @theme.PreviewBg;">
                            <span class="theme-card-accent-dot" style="background: @theme.PreviewAccent;"></span>
                            @if (selectedTheme == id)
                            {
                                <span class="theme-card-check">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                                </span>
                            }
                        </div>
                        <span class="theme-card-name">@theme.Name</span>
                    </button>
                }
            </div>
        </div>

        <div class="settings-section">
            <h3>Multi-Device Login</h3>

            <span class="form-hint" style="margin-bottom: 12px;">@MultiDeviceSummary</span>

            @if (hasPassword)
            {
                <span class="form-hint" style="margin-bottom: 12px;">Use this secret code to log in as <strong>@UserState.Username</strong> on another device or browser.</span>
                <div class="passphrase-display">
                    <span class="passphrase-value">@(showPassphrase ? currentPassword : "••••••••••")</span>
                    <button class="passphrase-eye" @onclick="() => showPassphrase = !showPassphrase" title="@(showPassphrase ? "Hide" : "Reveal")">
                        @if (showPassphrase)
                        {
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                        }
                        else
                        {
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                        }
                    </button>
                    <button class="passphrase-eye" @onclick="CopyPassphrase" title="@(_copiedPassphrase ? "Copied!" : "Copy")">
                        @if (_copiedPassphrase)
                        {
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                        }
                        else
                        {
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                        }
                    </button>
                </div>
                <div class="passphrase-actions">
                    <button class="remove-button" @onclick="RegeneratePassphrase">New Code</button>
                    <button class="remove-button" @onclick="RemovePassword">Disable</button>
                </div>
                @if (passwordSaveStatus != null)
                {
                    <span class="save-status saved" style="margin-top: 4px;">@passwordSaveStatus</span>
                }
            }
            else
            {
                <span class="form-hint" style="margin-bottom: 12px;">Enable a secret code to log in from other devices or browsers.</span>
                <button class="upload-button" @onclick="EnablePassphrase">Enable Secret Code</button>
                @if (passwordSaveStatus != null)
                {
                    <span class="save-status saved" style="margin-top: 4px;">@passwordSaveStatus</span>
                }
            }

            @if (RegistrationGate.SmartMode)
            {
                <div style="margin-top: 16px; padding-top: 16px; border-top: 1px solid var(--border-primary);">
                    <label class="toggle-row">
                        <div class="toggle-info">
                            <span class="toggle-label">Allow smart login</span>
                            <span class="toggle-hint">Log in from new devices on the same network without a secret code.</span>
                        </div>
                        <label class="toggle-switch">
                            <input type="checkbox" checked="@smartLoginAllowed" @onchange="ToggleSmartLogin" />
                            <span class="toggle-slider"></span>
                        </label>
                    </label>
                </div>
            }
        </div>

        <div class="settings-section">
            <h3>Active Sessions</h3>

            @if (sessions.Count > 0)
            {
                <div class="sessions-list">
                    @foreach (var session in sessions)
                    {
                        var isCurrentDevice = session.SessionId == UserState.SessionId;
                        <div class="session-item @(isCurrentDevice ? "current" : "")">
                            <span class="session-icon">@(session.IsMobile == true ? "📱" : "🖥️")</span>
                            <div class="session-details">
                                <div class="session-line">
                                    @if (isCurrentDevice)
                                    {
                                        <span class="session-badge">This device</span>
                                    }
                                    <span class="session-ip">@(session.ClientIp ?? "Unknown IP")</span>
                                </div>
                                <span class="session-activity">Active @FormatRelativeTime(session.LastActivity)</span>
                            </div>
                        </div>
                    }
                </div>

                @if (sessions.Count > 1)
                {
                    <div style="margin-top: 12px;">
                        <button class="remove-button" @onclick="SignOutOtherDevices" disabled="@isSigningOutOthers">
                            @(isSigningOutOthers ? "Signing out..." : "Sign out all other devices")
                        </button>
                    </div>
                    @if (signOutStatus != null)
                    {
                        <span class="save-status saved" style="margin-top: 4px;">@signOutStatus</span>
                    }
                }
            }
            else
            {
                <span class="form-hint">No active sessions.</span>
            }
        </div>

        

        <div class="settings-section">
            <h3>Install as App</h3>

            @if (isPwa)
            {
                <div class="pwa-installed-info">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="pwa-check-icon">
                        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" />
                    </svg>
                    <span>Yap is installed as an app on this device.</span>
                </div>
            }
            else
            {
                <p class="pwa-description">Install Yap to your home screen for a full-screen experience with push notifications and quick access.</p>
                <button class="upload-button" @onclick="InstallPwa">Install Yap</button>
            }
        </div>

        <div class="settings-section">
            <h3>Notifications</h3>

            <div class="notification-status">
                <div class="notification-row">
                    <span class="notification-label">Push Notifications</span>
                    <span class="notification-value @GetPushStatusClass()">@GetPushStatusText()</span>
                </div>

                @if (!string.IsNullOrEmpty(pushPermission) && pushPermission != "unsupported")
                {
                    <div class="notification-row">
                        <span class="notification-label">Browser Permission</span>
                        <span class="notification-value @GetPermissionClass()">@pushPermission</span>
                    </div>
                }

                <div class="notification-row">
                    <span class="notification-label">Subscribed Devices</span>
                    <span class="notification-value">@serverSubscriptionCount device(s)</span>
                </div>

            </div>

            @if (pushDevices.Count > 0)
            {
                <div class="sessions-list" style="margin-bottom: 1rem;">
                    @foreach (var device in pushDevices)
                    {
                        var isThisDevice = currentEndpoint != null && device.Endpoint == currentEndpoint;
                        <div class="session-item @(isThisDevice ? "current" : "")">
                            <span class="session-icon">🔔</span>
                            <div class="session-details">
                                <div class="session-line">
                                    @if (isThisDevice)
                                    {
                                        <span class="session-badge">This device</span>
                                    }
                                    <span class="session-ip">@DescribePushEndpoint(device.Endpoint)</span>
                                </div>
                                <span class="session-activity">Added @FormatRelativeTime(device.CreatedAt)</span>
                            </div>
                            <button class="remove-button" style="margin-left: auto; padding: 0.25rem 0.625rem; font-size: 0.75rem; flex-shrink: 0;"
                                    @onclick="() => RemovePushDevice(device.Endpoint)" title="Remove this device">
                                Remove
                            </button>
                        </div>
                    }
                </div>
            }

            <div class="notification-actions">
                @if (!pushSupported)
                {
                    <span class="form-hint">Push notifications are not supported in this browser.</span>
                }
                else if (!PushService.IsConfigured)
                {
                    <span class="form-hint">Push notifications are not configured on this server.</span>
                }
                else if (pushPermission == "denied")
                {
                    <span class="form-hint">Notification permission was denied. Reset it in your browser settings to re-enable.</span>
                }
                else if (pushSubscribed)
                {
                    <span class="form-hint">
                        @if (pushMuted)
                        {
                            <text>Notifications are muted — you'll still see the unread badge on the app icon, but no banners or sounds.</text>
                        }
                        else
                        {
                            <text>You'll receive banner alerts with message previews and the unread badge on the app icon.</text>
                        }
                    </span>
                    <div class="notification-buttons">
                        <button class="@(pushMuted ? "upload-button" : "remove-button")" @onclick="ToggleMute" disabled="@pushToggling">
                            @(pushMuted ? "Unmute Notifications" : "Mute Notifications")
                        </button>
                        <button class="remove-button" @onclick="DisablePush" disabled="@pushToggling">
                            @(pushToggling ? "Disabling..." : "Unsubscribe")
                        </button>
                    </div>
                }
                else
                {
                    <button class="upload-button" @onclick="EnablePush" disabled="@pushToggling">
                        @(pushToggling ? "Enabling..." : "Enable Notifications")
                    </button>
                }

                @if (PushService.IsConfigured && serverSubscriptionCount > 0)
                {
                    <div class="notification-buttons" style="margin-top: 8px;">
                        <button class="upload-button" @onclick="SendTestNotification" disabled="@sendingTest">
                            @(sendingTest ? "Sending..." : "Send test notification")
                        </button>
                    </div>
                    <span class="form-hint">Sends a notification to every subscribed device — the ones that buzz are alive.</span>
                }
                @if (pushActionStatus != null)
                {
                    <span class="save-status saved" style="margin-top: 4px;">@pushActionStatus</span>
                }
            </div>
        </div>

        <div class="settings-section">
            <h3>Time & Date</h3>

            <div class="form-group">
                <label>Your time</label>
                <div class="time-widget">
                    <button class="time-adjust-btn" @onclick="() => AdjustTimezone(-1)" title="−1 hour">−</button>
                    <span class="current-time">@GetCurrentTime()</span>
                    <button class="time-adjust-btn" @onclick="() => AdjustTimezone(1)" title="+1 hour">+</button>
                    <button class="upload-button" @onclick="DetectTimezone" style="white-space: nowrap; margin-left: 8px;">
                        Detect
                    </button>
                </div>
                <span class="form-hint">Adjust if the time doesn't match your clock</span>
            </div>

            @{
                var previewTime = GetPreviewTime();
                var activeCulture = GetActiveCulture();
                var availableCultures = LocaleResolver.GetAvailableCultures(UserState.Locale, timeZone);
            }

            <div class="form-group">
                <label>Clock</label>
                <div class="format-options">
                    @foreach (var clk in LocaleResolver.GetOrderedClockStyles(UserState.Locale))
                    {
                        var id = clk.Id;
                        <label class="format-option @(clockStyle == id ? "selected" : "")">
                            <input type="radio" name="clock" checked="@(clockStyle == id)"
                                   @onchange="() => SelectClock(id)" />
                            <span class="format-example">@previewTime.ToString(clk.TimeFormat, activeCulture)</span>
                        </label>
                    }
                </div>
            </div>

            <div class="form-group">
                <label>Date order</label>
                <div class="format-options">
                    @foreach (var order in LocaleResolver.GetOrderedDateOrders(UserState.Locale))
                    {
                        var id = order.Id;
                        <label class="format-option @(dateOrder == id ? "selected" : "")">
                            <input type="radio" name="dateOrder" checked="@(dateOrder == id)"
                                   @onchange="() => SelectDateOrder(id)" />
                            <span class="format-example">@previewTime.ToString(order.FullDate, activeCulture)</span>
                        </label>
                    }
                </div>
            </div>

            @if (availableCultures.Count > 1)
            {
                <div class="form-group">
                    <label>Separators</label>
                    <div class="format-options">
                        @foreach (var c in availableCultures)
                        {
                            var name = c.Name;
                            var isSelected = (cultureOverride == null && name == availableCultures[0].Name)
                                          || cultureOverride == name;
                            var fmt = LocaleResolver.BuildFormat(dateOrder, clockStyle);
                            <label class="format-option @(isSelected ? "selected" : "")">
                                <input type="radio" name="separators" checked="@isSelected"
                                       @onchange="() => SelectCulture(name)" />
                                <span class="format-example">@fmt.FormatExample(previewTime, c)</span>
                                <span class="format-label">@c.NativeName</span>
                            </label>
                        }
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(UserState.TimeZone) || !string.IsNullOrEmpty(UserState.Locale))
            {
                <span class="form-hint">Detected: @(UserState.TimeZone ?? "—") · @(UserState.Locale ?? "—")</span>
            }
        </div>
       
    </div>
</div>

@code {
    private string? displayName;
    private string? profilePictureUrl;
    private string? bio;
    private string? country;
    private string? detectedLocation;
    private string? timeZone;
    private string dateOrder = "dmy";
    private string clockStyle = "24h";
    private string? cultureOverride;
    private string selectedTheme = ThemeRegistry.DefaultId;

    private bool isUploading = false;
    private string? saveStatus;
    private CancellationTokenSource? _debounceCts;

    // Account security state
    private bool hasPassword;
    private string? currentPassword;
    private bool showPassphrase;
    private string? passwordSaveStatus;
    private bool smartLoginAllowed = true;
    private bool _copiedPassphrase;

    private string MultiDeviceSummary
    {
        get
        {
            var smartEnabled = RegistrationGate.SmartMode && smartLoginAllowed;
            if (hasPassword && smartEnabled)
                return "You can log in from other devices using your secret code or automatically from the same network.";
            if (hasPassword)
                return "You can log in from other devices using your secret code.";
            if (smartEnabled)
                return "You can log in from other devices automatically when on the same network.";
            return "This account is tied to this device only.";
        }
    }

    // Active sessions state
    private List<ChatService.UserSession> sessions = new();
    private bool isSigningOutOthers = false;
    private string? signOutStatus;
    private bool showKickedNotice;

    // Push notification state
    private bool pushSupported = false;
    private bool pushSubscribed = false;
    private bool pushMuted = false;
    private string? pushPermission;
    private int serverSubscriptionCount = 0;
    private bool isPwa = false;
    private bool pushToggling = false;

    // Per-device subscription list (Lite — no schema change)
    private IReadOnlyList<Yap.Models.PushSubscription> pushDevices = new List<Yap.Models.PushSubscription>();
    private string? currentEndpoint;       // this browser's push endpoint (for the "This device" badge)
    private bool sendingTest = false;
    private string? pushActionStatus;

    protected override void OnInitialized()
    {
        if (!UserState.IsLoggedIn || !UserState.UserId.HasValue)
        {
            Navigation.NavigateTo("/");
            return;
        }

        // Load current values
        var user = UserService.GetById(UserState.UserId.Value);
        if (user != null)
        {
            displayName = user.DisplayName;
            profilePictureUrl = user.ProfilePictureUrl;
            bio = user.Bio;
            country = user.Country;
            timeZone = user.TimeZone;
            if (user.DateFormat != null)
            {
                (dateOrder, clockStyle, cultureOverride) = LocaleResolver.ParseDateFormat(user.DateFormat);
            }
            else
            {
                dateOrder = LocaleResolver.GuessDateOrderFromLocale(user.Locale);
                clockStyle = LocaleResolver.GuessClockFromLocale(user.Locale);
            }
            pushMuted = user.PushMuted;
            selectedTheme = ThemeRegistry.IsKnown(user.Theme) ? user.Theme! : ThemeRegistry.DefaultId;

            // Load password state
            currentPassword = user.Password;
            hasPassword = currentPassword != null;
            smartLoginAllowed = !user.SmartLoginOptOut;
        }

        // Detect location from IP for the Detect button
        if (GeoLocation.IsAvailable)
        {
            var clientIp = HttpContextAccessor.HttpContext?.Items["ClientIp"]?.ToString();
            var geo = GeoLocation.Lookup(clientIp);
            var location = geo?.ToString();
            if (!string.IsNullOrEmpty(location))
                detectedLocation = location;
        }

        // Server-side subscription list (doesn't need JS)
        RefreshPushDevices();

        // Load active sessions
        if (UserState.Username != null)
        {
            sessions = ChatService.GetSessionsForUser(UserState.Username);
            ChatService.OnUsersListChanged += HandleUsersListChanged;
        }

        // Check if we just kicked other devices (query param from redirect)
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        if (Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query).TryGetValue("kicked", out var kicked) && kicked == "1")
        {
            showKickedNotice = true;
            showPassphrase = true; // reveal so user sees the new passphrase
        }

        // Set nav context
        NavState.SetTitleWithBack("Settings");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadPushStatusAsync();
            StateHasChanged();
        }
    }

    private void OnDisplayNameInput(ChangeEventArgs e)
    {
        displayName = e.Value?.ToString();
        DebounceSave();
    }

    private void OnBioInput(ChangeEventArgs e)
    {
        bio = e.Value?.ToString();
        DebounceSave();
    }

    private void OnCountryInput(ChangeEventArgs e)
    {
        country = e.Value?.ToString();
        DebounceSave();
    }

    // --- Time & Date handlers ---

    private string GetCurrentTime()
    {
        var tz = LocaleResolver.ResolveTimeZone(timeZone) ?? TimeZoneInfo.Utc;
        var now = TimeZoneInfo.ConvertTime(DateTimeOffset.UtcNow, tz);
        var clk = LocaleResolver.ClockStyles.FirstOrDefault(c => c.Id == clockStyle) ?? LocaleResolver.ClockStyles[0];
        return now.ToString(clk.TimeFormat, GetActiveCulture());
    }

    private DateTimeOffset GetPreviewTime()
    {
        var tz = LocaleResolver.ResolveTimeZone(timeZone) ?? TimeZoneInfo.Utc;
        return TimeZoneInfo.ConvertTime(DateTimeOffset.UtcNow, tz);
    }

    private async Task AdjustTimezone(int hours)
    {
        var tz = LocaleResolver.ResolveTimeZone(timeZone) ?? TimeZoneInfo.Utc;
        var newOffset = tz.BaseUtcOffset.Add(TimeSpan.FromHours(hours));

        // Clamp to valid range
        if (newOffset.TotalHours < -14) newOffset = TimeSpan.FromHours(-14);
        if (newOffset.TotalHours > 14) newOffset = TimeSpan.FromHours(14);

        timeZone = LocaleResolver.FormatOffset(newOffset);
        await SaveTimeDateAsync();
    }

    private async Task DetectTimezone()
    {
        try
        {
            var info = await JS.InvokeAsync<ClientLocaleInfo>("getClientLocaleInfo");
            if (!string.IsNullOrEmpty(info.TimeZone))
            {
                timeZone = info.TimeZone;
                await SaveTimeDateAsync();
            }
        }
        catch { /* JS not available */ }
    }

    private async Task SelectDateOrder(string id)
    {
        dateOrder = id;
        await SaveTimeDateAsync();
    }

    private async Task SelectClock(string id)
    {
        clockStyle = id;
        await SaveTimeDateAsync();
    }

    private async Task SelectCulture(string cultureName)
    {
        var available = LocaleResolver.GetAvailableCultures(UserState.Locale, timeZone);
        // If selecting the browser default (first in list), clear the override
        cultureOverride = available.Count > 0 && available[0].Name == cultureName
            ? null
            : cultureName;
        await SaveTimeDateAsync();
    }

    private System.Globalization.CultureInfo GetActiveCulture()
    {
        if (!string.IsNullOrEmpty(cultureOverride))
        {
            try { return LocaleResolver.SanitizeCulture(new System.Globalization.CultureInfo(cultureOverride)); }
            catch { }
        }
        return UserState.GetCultureInfo();
    }

    private async Task SaveTimeDateAsync()
    {
        if (!UserState.UserId.HasValue) return;

        var normalizedTz = string.IsNullOrWhiteSpace(timeZone) ? null : timeZone.Trim();
        var dateFormat = cultureOverride != null
            ? $"{dateOrder}-{clockStyle}-{cultureOverride}"
            : $"{dateOrder}-{clockStyle}";
        UserState.TimeZone = normalizedTz;
        UserState.DateFormat = dateFormat;

        await UserService.UpdateLocaleAsync(UserState.UserId.Value, normalizedTz, UserState.Locale, dateFormat);
    }

    private void FillDetectedLocation()
    {
        if (detectedLocation != null)
        {
            country = detectedLocation;
            DebounceSave();
        }
    }

    private void DebounceSave()
    {
        _debounceCts?.Cancel();
        _debounceCts = new CancellationTokenSource();
        var token = _debounceCts.Token;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(800, token);
                await InvokeAsync(async () =>
                {
                    await SaveProfileAsync();
                    StateHasChanged();
                });
            }
            catch (TaskCanceledException) { }
        }, token);
    }

    private async Task SaveProfileAsync()
    {
        if (!UserState.UserId.HasValue) return;

        saveStatus = "Saving...";
        StateHasChanged();

        try
        {
            var normalizedDisplayName = string.IsNullOrWhiteSpace(displayName) ? null : displayName.Trim();
            var normalizedBio = string.IsNullOrWhiteSpace(bio) ? null : bio.Trim();
            var normalizedCountry = string.IsNullOrWhiteSpace(country) ? null : country.Trim();
            var cleanProfileUrl = profilePictureUrl?.Split('?')[0];

            await UserService.UpdateProfileAsync(
                UserState.UserId.Value,
                normalizedDisplayName,
                cleanProfileUrl,
                normalizedBio,
                normalizedCountry);

            UserState.DisplayName = normalizedDisplayName;
            UserState.ProfilePictureUrl = cleanProfileUrl;

            saveStatus = "Saved";
            StateHasChanged();

            // Clear "Saved" after a short delay
            _ = Task.Run(async () =>
            {
                await Task.Delay(2000);
                await InvokeAsync(() =>
                {
                    if (saveStatus == "Saved")
                    {
                        saveStatus = null;
                        StateHasChanged();
                    }
                });
            });
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save profile for {Username}", UserState.Username);
            saveStatus = null;
        }
    }

    private async Task HandleProfilePictureUpload(InputFileChangeEventArgs e)
    {
        if (isUploading) return;

        var file = e.File;
        if (file == null) return;

        if (!file.ContentType.StartsWith("image/")) return;
        if (file.Size > 10 * 1024 * 1024) return;

        isUploading = true;
        StateHasChanged();

        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            var url = await ImageService.GenerateProfilePictureAsync(stream, UserState.UserId!.Value);
            if (url != null)
            {
                profilePictureUrl = $"{url}?v={DateTime.UtcNow.Ticks}";
                await SaveProfileAsync();
            }
        }
        finally
        {
            isUploading = false;
            StateHasChanged();
        }
    }

    private async Task RemoveProfilePicture()
    {
        if (UserState.UserId.HasValue)
        {
            ImageService.DeleteProfilePicture(UserState.UserId.Value);
        }
        profilePictureUrl = null;
        await SaveProfileAsync();
    }

    private void GoBack()
    {
        // Flush any pending debounced save immediately
        _debounceCts?.Cancel();
        if (UserState.UserId.HasValue)
        {
            var normalizedDisplayName = string.IsNullOrWhiteSpace(displayName) ? null : displayName.Trim();
            var normalizedBio = string.IsNullOrWhiteSpace(bio) ? null : bio.Trim();
            var normalizedCountry = string.IsNullOrWhiteSpace(country) ? null : country.Trim();
            var cleanProfileUrl = profilePictureUrl?.Split('?')[0];

            _ = UserService.UpdateProfileAsync(
                UserState.UserId.Value,
                normalizedDisplayName,
                cleanProfileUrl,
                normalizedBio,
                normalizedCountry);

            UserState.DisplayName = normalizedDisplayName;
            UserState.ProfilePictureUrl = cleanProfileUrl;
        }

        Navigation.NavigateTo("/lobby");
    }


@page "/settings"
@layout ChatLayout
@inject UserStateService UserState
@inject UserService UserService
@inject ImageService ImageService
@inject ChatNavigationState NavState
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject PushSubscriptionStore PushStore
@inject PushNotificationService PushService
@inject GeoLocationService GeoLocation
@inject IHttpContextAccessor HttpContextAccessor
@inject ILogger<Settings> Logger
@implements IDisposable

<PageTitle>Settings</PageTitle>

<div class="settings-container">
    <div class="settings-header">
        <h2>Settings</h2>
        @if (saveStatus != null)
        {
            <span class="save-status @(saveStatus == "Saved" ? "saved" : "saving")">@saveStatus</span>
        }
    </div>

    <div class="settings-content">
        <p class="form-hint" style="margin-bottom: 12px;">Changes are saved automatically.</p>
        <div class="settings-section">
            <h3>Profile</h3>

            <div class="profile-picture-section">
                <Avatar Username="@(UserState.Username ?? "")"
                        ProfilePictureUrl="@profilePictureUrl"
                        Size="AvatarSize.Large" />

                <div class="profile-picture-actions">
                    <InputFile OnChange="HandleProfilePictureUpload" accept="image/*" id="profile-upload" class="file-input" />
                    <label for="profile-upload" class="upload-button">
                        @if (isUploading)
                        {
                            <span>Uploading...</span>
                        }
                        else
                        {
                            <span>@(string.IsNullOrEmpty(profilePictureUrl) ? "Upload Picture" : "Change Picture")</span>
                        }
                    </label>
                    @if (!string.IsNullOrEmpty(profilePictureUrl))
                    {
                        <button class="remove-button" @onclick="RemoveProfilePicture" disabled="@isUploading">
                            Remove
                        </button>
                    }
                </div>
            </div>

            <div class="form-group">
                <label for="display-name">Display Name</label>
                <input type="text" id="display-name" value="@displayName"
                       @oninput="OnDisplayNameInput"
                       placeholder="@(UserState.Username ?? "Username")" maxlength="64" class="form-input" />
                <span class="form-hint">Your username is @UserState.Username, but your display name can be more fun. It can contain symbols and emojis :) </span>
            </div>

            <div class="form-group">
                <label for="bio">Bio</label>
                <textarea id="bio" value="@bio"
                          @oninput="OnBioInput" maxlength="150"
                          placeholder="Why are you awesome..." class="form-textarea"></textarea>
                <span class="form-counter">@(bio?.Length ?? 0)/150</span>
            </div>

            <div class="form-group">
                <label for="country">Tell us where are you from - we have map!</label>
                <div style="display: flex; gap: 8px; align-items: center;">
                    <input type="text" id="country" value="@country"
                           @oninput="OnCountryInput"
                           placeholder="London" maxlength="100" class="form-input" style="flex: 1;" />
                    @if (detectedLocation != null)
                    {
                        <button class="upload-button" @onclick="FillDetectedLocation" style="white-space: nowrap;">
                            Detect
                        </button>
                    }
                </div>
                <span class="form-hint">Your location — used for the user map</span>
            </div>
        </div>

        <div class="settings-section">
            <h3>Time & Date</h3>

            <div class="form-group">
                <label>Your time</label>
                <div class="time-widget">
                    <button class="time-adjust-btn" @onclick="() => AdjustTimezone(-1)" title="−1 hour">−</button>
                    <span class="current-time">@GetCurrentTime()</span>
                    <button class="time-adjust-btn" @onclick="() => AdjustTimezone(1)" title="+1 hour">+</button>
                    <button class="upload-button" @onclick="DetectTimezone" style="white-space: nowrap; margin-left: 8px;">
                        Detect
                    </button>
                </div>
                <span class="form-hint">Adjust if the time doesn't match your clock</span>
            </div>

            <div class="form-group">
                <label>Date format</label>
                @{
                    var previewTime = GetPreviewTime();
                }
                <div class="format-options">
                    @foreach (var preset in LocaleResolver.Presets)
                    {
                        var id = preset.Id;
                        <label class="format-option @(dateFormat == id ? "selected" : "")">
                            <input type="radio" name="dateFormat" checked="@(dateFormat == id)"
                                   @onchange="() => SelectDateFormat(id)" />
                            <span class="format-example">@preset.FormatExample(previewTime)</span>
                            <span class="format-label">@preset.Label</span>
                        </label>
                    }
                </div>
            </div>
        </div>

        <div class="settings-section">
            <h3>Notifications</h3>

            <div class="notification-status">
                <div class="notification-row">
                    <span class="notification-label">Push Notifications</span>
                    <span class="notification-value @GetPushStatusClass()">@GetPushStatusText()</span>
                </div>

                @if (!string.IsNullOrEmpty(pushPermission) && pushPermission != "unsupported")
                {
                    <div class="notification-row">
                        <span class="notification-label">Browser Permission</span>
                        <span class="notification-value @GetPermissionClass()">@pushPermission</span>
                    </div>
                }

                <div class="notification-row">
                    <span class="notification-label">Server Subscriptions</span>
                    <span class="notification-value">@serverSubscriptionCount device(s)</span>
                </div>

            </div>

            <div class="notification-actions">
                @if (!pushSupported)
                {
                    <span class="form-hint">Push notifications are not supported in this browser.</span>
                }
                else if (!PushService.IsConfigured)
                {
                    <span class="form-hint">Push notifications are not configured on this server.</span>
                }
                else if (pushPermission == "denied")
                {
                    <span class="form-hint">Notification permission was denied. Reset it in your browser settings to re-enable.</span>
                }
                else if (pushSubscribed)
                {
                    <span class="form-hint">
                        @if (pushMuted)
                        {
                            <text>Notifications are muted — you'll still see the unread badge on the app icon, but no banners or sounds.</text>
                        }
                        else
                        {
                            <text>You'll receive banner alerts with message previews and the unread badge on the app icon.</text>
                        }
                    </span>
                    <div class="notification-buttons">
                        <button class="@(pushMuted ? "upload-button" : "remove-button")" @onclick="ToggleMute" disabled="@pushToggling">
                            @(pushMuted ? "Unmute Notifications" : "Mute Notifications")
                        </button>
                        <button class="remove-button" @onclick="DisablePush" disabled="@pushToggling">
                            @(pushToggling ? "Disabling..." : "Unsubscribe")
                        </button>
                    </div>
                }
                else
                {
                    <button class="upload-button" @onclick="EnablePush" disabled="@pushToggling">
                        @(pushToggling ? "Enabling..." : "Enable Notifications")
                    </button>
                }
            </div>
        </div>

        <div class="settings-section">
            <h3>Install as App</h3>

            @if (isPwa)
            {
                <div class="pwa-installed-info">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="pwa-check-icon">
                        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                    </svg>
                    <span>Yap is installed as an app on this device.</span>
                </div>
            }
            else
            {
                <p class="pwa-description">Install Yap to your home screen for a full-screen experience with push notifications and quick access.</p>
                <button class="upload-button" @onclick="InstallPwa">Install Yap</button>
            }
        </div>
    </div>
</div>

@code {
    private string? displayName;
    private string? profilePictureUrl;
    private string? bio;
    private string? country;
    private string? detectedLocation;
    private string? timeZone;
    private string? dateFormat;

    private bool isUploading = false;
    private string? saveStatus;
    private CancellationTokenSource? _debounceCts;

    // Push notification state
    private bool pushSupported = false;
    private bool pushSubscribed = false;
    private bool pushMuted = false;
    private string? pushPermission;
    private int serverSubscriptionCount = 0;
    private bool isPwa = false;
    private bool pushToggling = false;

    protected override void OnInitialized()
    {
        if (!UserState.IsLoggedIn || !UserState.UserId.HasValue)
        {
            Navigation.NavigateTo("/");
            return;
        }

        // Load current values
        var user = UserService.GetById(UserState.UserId.Value);
        if (user != null)
        {
            displayName = user.DisplayName;
            profilePictureUrl = user.ProfilePictureUrl;
            bio = user.Bio;
            country = user.Country;
            timeZone = user.TimeZone;
            dateFormat = user.DateFormat ?? LocaleResolver.GuessPresetFromLocale(user.Locale);
            pushMuted = user.PushMuted;
        }

        // Detect location from IP for the Detect button
        if (GeoLocation.IsAvailable)
        {
            var clientIp = HttpContextAccessor.HttpContext?.Items["ClientIp"]?.ToString();
            var geo = GeoLocation.Lookup(clientIp);
            var location = geo?.ToString();
            if (!string.IsNullOrEmpty(location))
                detectedLocation = location;
        }

        // Server-side subscription count (doesn't need JS)
        if (UserState.Username != null)
        {
            serverSubscriptionCount = PushStore.GetSubscriptions(UserState.Username).Count();
        }

        // Set nav context
        NavState.SetTitleWithBack("Settings");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadPushStatusAsync();
            StateHasChanged();
        }
    }

    private void OnDisplayNameInput(ChangeEventArgs e)
    {
        displayName = e.Value?.ToString();
        DebounceSave();
    }

    private void OnBioInput(ChangeEventArgs e)
    {
        bio = e.Value?.ToString();
        DebounceSave();
    }

    private void OnCountryInput(ChangeEventArgs e)
    {
        country = e.Value?.ToString();
        DebounceSave();
    }

    // --- Time & Date handlers ---

    private string GetCurrentTime()
    {
        var tz = LocaleResolver.ResolveTimeZone(timeZone) ?? TimeZoneInfo.Utc;
        var now = TimeZoneInfo.ConvertTime(DateTimeOffset.UtcNow, tz);
        var fmt = LocaleResolver.GetPreset(dateFormat);
        return now.ToString(fmt.Time, System.Globalization.CultureInfo.InvariantCulture);
    }

    private DateTimeOffset GetPreviewTime()
    {
        var tz = LocaleResolver.ResolveTimeZone(timeZone) ?? TimeZoneInfo.Utc;
        return TimeZoneInfo.ConvertTime(DateTimeOffset.UtcNow, tz);
    }

    private async Task AdjustTimezone(int hours)
    {
        var tz = LocaleResolver.ResolveTimeZone(timeZone) ?? TimeZoneInfo.Utc;
        var newOffset = tz.BaseUtcOffset.Add(TimeSpan.FromHours(hours));

        // Clamp to valid range
        if (newOffset.TotalHours < -14) newOffset = TimeSpan.FromHours(-14);
        if (newOffset.TotalHours > 14) newOffset = TimeSpan.FromHours(14);

        timeZone = LocaleResolver.FormatOffset(newOffset);
        await SaveTimeDateAsync();
    }

    private async Task DetectTimezone()
    {
        try
        {
            var info = await JS.InvokeAsync<ClientLocaleInfo>("getClientLocaleInfo");
            if (!string.IsNullOrEmpty(info.TimeZone))
            {
                timeZone = info.TimeZone;
                await SaveTimeDateAsync();
            }
        }
        catch { /* JS not available */ }
    }

    private async Task SelectDateFormat(string id)
    {
        dateFormat = id;
        await SaveTimeDateAsync();
    }

    private async Task SaveTimeDateAsync()
    {
        if (!UserState.UserId.HasValue) return;

        var normalizedTz = string.IsNullOrWhiteSpace(timeZone) ? null : timeZone.Trim();
        UserState.TimeZone = normalizedTz;
        UserState.DateFormat = dateFormat;

        await UserService.UpdateLocaleAsync(UserState.UserId.Value, normalizedTz, UserState.Locale, dateFormat);
    }

    private void FillDetectedLocation()
    {
        if (detectedLocation != null)
        {
            country = detectedLocation;
            DebounceSave();
        }
    }

    private void DebounceSave()
    {
        _debounceCts?.Cancel();
        _debounceCts = new CancellationTokenSource();
        var token = _debounceCts.Token;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(800, token);
                await InvokeAsync(async () =>
                {
                    await SaveProfileAsync();
                    StateHasChanged();
                });
            }
            catch (TaskCanceledException) { }
        }, token);
    }

    private async Task SaveProfileAsync()
    {
        if (!UserState.UserId.HasValue) return;

        saveStatus = "Saving...";
        StateHasChanged();

        try
        {
            var normalizedDisplayName = string.IsNullOrWhiteSpace(displayName) ? null : displayName.Trim();
            var normalizedBio = string.IsNullOrWhiteSpace(bio) ? null : bio.Trim();
            var normalizedCountry = string.IsNullOrWhiteSpace(country) ? null : country.Trim();
            var cleanProfileUrl = profilePictureUrl?.Split('?')[0];

            await UserService.UpdateProfileAsync(
                UserState.UserId.Value,
                normalizedDisplayName,
                cleanProfileUrl,
                normalizedBio,
                normalizedCountry);

            UserState.DisplayName = normalizedDisplayName;
            UserState.ProfilePictureUrl = cleanProfileUrl;

            saveStatus = "Saved";
            StateHasChanged();

            // Clear "Saved" after a short delay
            _ = Task.Run(async () =>
            {
                await Task.Delay(2000);
                await InvokeAsync(() =>
                {
                    if (saveStatus == "Saved")
                    {
                        saveStatus = null;
                        StateHasChanged();
                    }
                });
            });
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save profile for {Username}", UserState.Username);
            saveStatus = null;
        }
    }

    private async Task HandleProfilePictureUpload(InputFileChangeEventArgs e)
    {
        if (isUploading) return;

        var file = e.File;
        if (file == null) return;

        if (!file.ContentType.StartsWith("image/")) return;
        if (file.Size > 10 * 1024 * 1024) return;

        isUploading = true;
        StateHasChanged();

        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            var url = await ImageService.GenerateProfilePictureAsync(stream, UserState.UserId!.Value);
            if (url != null)
            {
                profilePictureUrl = $"{url}?v={DateTime.UtcNow.Ticks}";
                await SaveProfileAsync();
            }
        }
        finally
        {
            isUploading = false;
            StateHasChanged();
        }
    }

    private async Task RemoveProfilePicture()
    {
        if (UserState.UserId.HasValue)
        {
            ImageService.DeleteProfilePicture(UserState.UserId.Value);
        }
        profilePictureUrl = null;
        await SaveProfileAsync();
    }

    private void GoBack()
    {
        // Flush any pending debounced save immediately
        _debounceCts?.Cancel();
        if (UserState.UserId.HasValue)
        {
            var normalizedDisplayName = string.IsNullOrWhiteSpace(displayName) ? null : displayName.Trim();
            var normalizedBio = string.IsNullOrWhiteSpace(bio) ? null : bio.Trim();
            var normalizedCountry = string.IsNullOrWhiteSpace(country) ? null : country.Trim();
            var cleanProfileUrl = profilePictureUrl?.Split('?')[0];

            _ = UserService.UpdateProfileAsync(
                UserState.UserId.Value,
                normalizedDisplayName,
                cleanProfileUrl,
                normalizedBio,
                normalizedCountry);

            UserState.DisplayName = normalizedDisplayName;
            UserState.ProfilePictureUrl = cleanProfileUrl;
        }

        Navigation.NavigateTo("/lobby");
    }

    // Push notification methods

    private async Task LoadPushStatusAsync()
    {
        try
        {
            pushSupported = await JS.InvokeAsync<bool>("isPushSupported");
            pushPermission = await JS.InvokeAsync<string>("getNotificationPermission");
            isPwa = await JS.InvokeAsync<bool>("isPwaInstalled");

            if (pushSupported)
            {
                var existingSub = await JS.InvokeAsync<string?>("getPushSubscription");
                pushSubscribed = existingSub != null;
            }

            Logger.LogDebug("Push status loaded: supported={Supported}, permission={Permission}, subscribed={Subscribed}, pwa={Pwa}, serverSubs={ServerSubs}",
                pushSupported, pushPermission, pushSubscribed, isPwa, serverSubscriptionCount);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load push notification status");
        }
    }

    private async Task EnablePush()
    {
        if (pushToggling || !pushSupported || !PushService.IsConfigured) return;
        pushToggling = true;
        StateHasChanged();

        try
        {
            var permission = await JS.InvokeAsync<string>("requestNotificationPermission");
            pushPermission = permission;

            if (permission != "granted")
            {
                Logger.LogDebug("Push enable: permission {Permission} for {Username}", permission, UserState.Username);
                return;
            }

            var publicKey = PushService.GetPublicKey();
            if (publicKey == null) return;

            var subscriptionJson = await JS.InvokeAsync<string?>("subscribeToPush", publicKey);
            if (subscriptionJson == null)
            {
                Logger.LogDebug("Push enable: browser subscription failed for {Username}", UserState.Username);
                return;
            }

            var subData = System.Text.Json.JsonSerializer.Deserialize<PushSubData>(subscriptionJson);
            if (subData != null && UserState.Username != null)
            {
                await PushStore.SaveSubscriptionAsync(UserState.Username, new PushSubscriptionInfo
                {
                    Endpoint = subData.Endpoint ?? "",
                    P256dh = subData.P256dh ?? "",
                    Auth = subData.Auth ?? ""
                });
                pushSubscribed = true;
                serverSubscriptionCount = PushStore.GetSubscriptions(UserState.Username).Count();
                Logger.LogDebug("Push enabled for {Username} from settings", UserState.Username);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to enable push for {Username}", UserState.Username);
        }
        finally
        {
            pushToggling = false;
            StateHasChanged();
        }
    }

    private async Task ToggleMute()
    {
        if (!UserState.UserId.HasValue) return;

        try
        {
            pushMuted = !pushMuted;
            await UserService.SetPushMutedAsync(UserState.UserId.Value, pushMuted);
            Logger.LogDebug("Notifications {State} for {Username} from settings", pushMuted ? "muted" : "unmuted", UserState.Username);
        }
        catch (Exception ex)
        {
            pushMuted = !pushMuted; // revert
            Logger.LogError(ex, "Failed to toggle mute for {Username}", UserState.Username);
        }
    }

    private async Task DisablePush()
    {
        if (pushToggling) return;
        pushToggling = true;
        StateHasChanged();

        try
        {
            var existingSub = await JS.InvokeAsync<string?>("getPushSubscription");
            if (existingSub != null)
            {
                var subData = System.Text.Json.JsonSerializer.Deserialize<PushSubData>(existingSub);
                await JS.InvokeAsync<bool>("unsubscribeFromPush");
                if (subData?.Endpoint != null)
                {
                    await PushStore.RemoveSubscriptionAsync(subData.Endpoint);
                }
            }

            if (UserState.Username != null)
            {
                await PushStore.RemoveUserSubscriptionsAsync(UserState.Username);
            }

            pushSubscribed = false;
            serverSubscriptionCount = 0;
            Logger.LogDebug("Push disabled for {Username} from settings", UserState.Username);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to disable push for {Username}", UserState.Username);
        }
        finally
        {
            pushToggling = false;
            StateHasChanged();
        }
    }

    private async Task InstallPwa()
    {
        await JS.InvokeVoidAsync("showPwaInstallGuide");
    }

    private record ClientLocaleInfo(string? TimeZone, string? Locale);

    private record PushSubData(
        [property: System.Text.Json.Serialization.JsonPropertyName("endpoint")] string? Endpoint,
        [property: System.Text.Json.Serialization.JsonPropertyName("p256dh")] string? P256dh,
        [property: System.Text.Json.Serialization.JsonPropertyName("auth")] string? Auth);

    private string GetPushStatusText()
    {
        if (!pushSupported) return "Not Supported";
        if (!PushService.IsConfigured) return "Not Configured";
        if (pushSubscribed) return "Enabled";
        return "Disabled";
    }

    private string GetPushStatusClass()
    {
        if (pushSubscribed) return "status-enabled";
        if (!pushSupported || !PushService.IsConfigured) return "status-unavailable";
        return "status-disabled";
    }

    private string GetPermissionClass()
    {
        return pushPermission switch
        {
            "granted" => "status-enabled",
            "denied" => "status-denied",
            _ => "status-disabled"
        };
    }

    public void Dispose()
    {
        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
    }
}

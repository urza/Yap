@page "/login"
@inject ChatConfigService ChatConfig
@inject UserService UserService
@inject UserStateService UserState
@inject SystemBotService BotService
@inject RegistrationGateService RegistrationGate
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>@ChatConfig.ProjectName</PageTitle>

<div class="username-container">
    @if (_state == LoginState.Closed)
    {
        <h2>Registration is temporarily closed</h2>
        <div class="closed-message">
            <p>New signups are not being accepted right now. Please check back later.</p>
        </div>
        <div class="build-info">@BuildInfo.Time</div>
    }
    else if (_state == LoginState.WaitingApproval)
    {
        <h2>Waiting for approval</h2>
        <div class="waiting-message">
            <div class="waiting-spinner"></div>
            <p>Your request to join as <strong>@usernameInput</strong> has been submitted.</p>
            <p class="waiting-hint">An admin will review your request shortly. This page will update automatically.</p>
            @if (_wasRejected)
            {
                <p class="rejection-notice">Your previous request was not approved. You can try a different username.</p>
                <button class="join-button" @onclick="ResetToForm">Try again</button>
            }
        </div>
        <div class="build-info">@BuildInfo.Time</div>
    }
    else
    {
        <h2>@welcomeMessage</h2>
        <div class="username-form">
            <div class="input-wrapper">
                <input type="text" @bind="usernameInput" @bind:event="oninput" @bind:after="ValidateUsername"
                       placeholder="@usernamePlaceholder" class="username-input @(showError ? "invalid" : "")"
                       @onkeypress="HandleUsernameKeyPress" @onblur="OnInputBlur" maxlength="23" />
                @if (showError)
                {
                    <span class="validation-error">@errorMessage</span>
                    @if (_showRetryLink)
                    {
                        <button type="button" @onclick="ValidateUsername" class="retry-link">Done, try again</button>
                    }
                }
            </div>
            <button class="join-button" @onclick="JoinChat"
                    disabled="@(!IsValid)">
                @joinButtonText
            </button>
        </div>
        <div class="build-info">@BuildInfo.Time</div>
    }
</div>

@code {
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private enum LoginState { Normal, Closed, WaitingApproval }
    private LoginState _state = LoginState.Normal;

    private string usernameInput = "";
    private string welcomeMessage = "";
    private string joinButtonText = "";
    private string usernamePlaceholder = "";
    private string errorMessage = "";
    private bool hasError = false;
    private bool isLengthError = false;
    private bool hasBlurred = false;
    private bool _shouldRedirect = false;
    private bool _usernameHasPassword = false;
    private bool _showRetryLink = false;
    private bool _wasRejected = false;

    private Timer? _pollTimer;

    // Username rules: 2-23 chars, lowercase a-z, 0-9, underscore, period, no consecutive periods
    private static readonly System.Text.RegularExpressions.Regex ValidUsernameRegex =
        new(@"^[a-z0-9._]+$", System.Text.RegularExpressions.RegexOptions.Compiled);

    private bool IsValid => !string.IsNullOrWhiteSpace(usernameInput) && (!hasError || _usernameHasPassword);

    // Only show length errors after user has blurred the input (finished typing)
    private bool showError => hasError && (!isLengthError || hasBlurred);

    // Validated return URL (must be relative path to prevent open redirect)
    private string? SafeReturnUrl =>
        !string.IsNullOrEmpty(ReturnUrl) && ReturnUrl.StartsWith("/") && !ReturnUrl.StartsWith("//")
            ? ReturnUrl
            : null;

    protected override void OnInitialized()
    {
        // Already authenticated (via cookie - UserState populated by AuthMiddleware)
        // Verify user still exists in database before redirecting
        if (UserState.IsLoggedIn && UserState.UserId.HasValue)
        {
            var existingUser = UserService.GetById(UserState.UserId.Value);
            if (existingUser != null)
            {
                _shouldRedirect = true;
                return;
            }
            else
            {
                // User no longer exists - clear the stale state
                UserState.UserId = null;
                UserState.Username = null;
                UserState.DisplayName = null;
                UserState.ProfilePictureUrl = null;
                UserState.SessionId = null;
                UserState.Status = UserStatus.Online;
            }
        }

        // Check if registration is closed (new visitors only)
        if (RegistrationGate.RegistrationClosed)
        {
            _state = LoginState.Closed;
            return;
        }

        welcomeMessage = ChatConfig.GetRandomWelcomeMessage();
        joinButtonText = ChatConfig.GetRandomJoinButtonText();
        usernamePlaceholder = ChatConfig.GetRandomUsernamePlaceholder();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && _shouldRedirect)
        {
            var destination = SafeReturnUrl ?? "/lobby";
            Navigation.NavigateTo(destination);
        }
    }

    private void ValidateUsername()
    {
        hasError = false;
        isLengthError = false;
        errorMessage = "";
        _usernameHasPassword = false;
        _showRetryLink = false;

        if (string.IsNullOrWhiteSpace(usernameInput))
            return;

        // Auto-trim and convert to lowercase
        var normalized = usernameInput.Trim().ToLowerInvariant();
        if (normalized != usernameInput)
        {
            usernameInput = normalized;
        }

        // Length check (2-32 characters)
        if (usernameInput.Length < 2)
        {
            hasError = true;
            isLengthError = true;
            errorMessage = "Username must be at least 2 characters";
            return;
        }

        // Character validation (a-z, 0-9, underscore, period only)
        if (!ValidUsernameRegex.IsMatch(usernameInput))
        {
            hasError = true;
            errorMessage = "Only lowercase letters, numbers, _ and . allowed";
            return;
        }

        // No consecutive periods
        if (usernameInput.Contains(".."))
        {
            hasError = true;
            errorMessage = "Cannot have consecutive periods";
            return;
        }

        // Bot username is reserved
        if (BotService.IsBotUser(usernameInput))
        {
            hasError = true;
            errorMessage = "Nice try! 🤖";
            return;
        }

        // Username taken check — if they have a password, redirect to verify page instead of error
        if (UserService.IsUsernameTaken(usernameInput))
        {
            if (UserService.HasPassword(usernameInput))
            {
                // Don't show error — user can proceed to verify page
                _usernameHasPassword = true;
            }
            else
            {
                hasError = true;
                _showRetryLink = true;
                errorMessage = "This account doesn't have a passphrase yet. Go to Settings on your original device and enable one, then come back here.";
            }
            return;
        }
    }

    private void HandleUsernameKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && IsValid) JoinChat();
    }

    private void OnInputBlur()
    {
        hasBlurred = true;
    }

    private void JoinChat()
    {
        if (!IsValid) return;

        var username = Uri.EscapeDataString(usernameInput.Trim());
        var returnUrl = SafeReturnUrl ?? "/lobby";

        // Username with password — redirect to verify page (stays in Blazor)
        if (_usernameHasPassword)
        {
            var encodedReturnUrl = Uri.EscapeDataString(returnUrl);
            Navigation.NavigateTo($"/verify/{username}?returnUrl={encodedReturnUrl}");
            return;
        }

        // Approval mode — add to pending set and wait
        if (RegistrationGate.RequireApproval)
        {
            var trimmed = usernameInput.Trim();
            if (!RegistrationGate.AddPendingUser(trimmed))
            {
                // Already pending
                hasError = true;
                errorMessage = "This username is already waiting for approval";
                return;
            }

            _state = LoginState.WaitingApproval;
            _wasRejected = false;

            // Notify admin via bot
            _ = BotService.NotifyAdminOfPendingUserAsync(trimmed);

            // Start polling for approval/rejection
            StartPolling();
            return;
        }

        // Normal mode — redirect to signin endpoint (creates user + sets cookie)
        var encodedReturn = Uri.EscapeDataString(returnUrl);
        Navigation.NavigateTo($"/auth/signin?username={username}&returnUrl={encodedReturn}", forceLoad: true);
    }

    private void StartPolling()
    {
        _pollTimer?.Dispose();
        _pollTimer = new Timer(async _ =>
        {
            try
            {
                await InvokeAsync(() =>
                {
                    var username = usernameInput.Trim();

                    if (RegistrationGate.IsApproved(username))
                    {
                        // Approved! Redirect to create the account (HandleSignIn will consume the approval)
                        _pollTimer?.Dispose();
                        _pollTimer = null;
                        var encodedUsername = Uri.EscapeDataString(username);
                        var returnUrl = SafeReturnUrl ?? "/lobby";
                        var encodedReturn = Uri.EscapeDataString(returnUrl);
                        Navigation.NavigateTo($"/auth/signin?username={encodedUsername}&returnUrl={encodedReturn}", forceLoad: true);
                        return;
                    }

                    if (RegistrationGate.IsRejected(username))
                    {
                        // Rejected — consume so it doesn't show again
                        RegistrationGate.ConsumeRejection(username);
                        _pollTimer?.Dispose();
                        _pollTimer = null;
                        _wasRejected = true;
                        StateHasChanged();
                        return;
                    }
                });
            }
            catch (ObjectDisposedException) { }
            catch (InvalidOperationException) { }
        }, null, TimeSpan.FromSeconds(3), TimeSpan.FromSeconds(3));
    }

    private void ResetToForm()
    {
        _state = LoginState.Normal;
        _wasRejected = false;
        usernameInput = "";
        hasError = false;
        welcomeMessage = ChatConfig.GetRandomWelcomeMessage();
        joinButtonText = ChatConfig.GetRandomJoinButtonText();
        usernamePlaceholder = ChatConfig.GetRandomUsernamePlaceholder();
    }

    public void Dispose()
    {
        _pollTimer?.Dispose();
    }
}

@page "/"
@inject ChatConfigService ChatConfig
@inject ChatService ChatService
@inject UserService UserService
@inject UserStateService UserState
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@ChatConfig.ProjectName</PageTitle>

<div class="username-container">
    <h2>@welcomeMessage</h2>
    <div class="username-form">
        <div class="input-wrapper">
            <input type="text" @bind="usernameInput" @bind:event="oninput" @bind:after="ValidateUsername"
                   placeholder="@usernamePlaceholder" class="username-input @(showError ? "invalid" : "")"
                   @onkeypress="HandleUsernameKeyPress" @onblur="OnInputBlur" maxlength="23" />
            @if (showError)
            {
                <span class="validation-error">@errorMessage</span>
            }
        </div>
        <button class="join-button" @onclick="JoinChat"
                disabled="@(!IsValid)">
            @joinButtonText
        </button>
    </div>
    <div class="build-info">@BuildInfo.Time</div>
</div>

@code {
    private string usernameInput = "";
    private string welcomeMessage = "";
    private string joinButtonText = "";
    private string usernamePlaceholder = "";
    private string errorMessage = "";
    private bool hasError = false;
    private bool isLengthError = false;
    private bool hasBlurred = false;
    private bool _shouldRedirect = false;

    // Username rules: 2-23 chars, lowercase a-z, 0-9, underscore, period, no consecutive periods
    private static readonly System.Text.RegularExpressions.Regex ValidUsernameRegex =
        new(@"^[a-z0-9._]+$", System.Text.RegularExpressions.RegexOptions.Compiled);

    private bool IsValid => !string.IsNullOrWhiteSpace(usernameInput) && !hasError;

    // Only show length errors after user has blurred the input (finished typing)
    private bool showError => hasError && (!isLengthError || hasBlurred);

    protected override void OnInitialized()
    {
        // If already logged in (persisted state), verify the user still exists in the database
        // before redirecting. This handles cases where the database was reset or the user was deleted.
        if (UserState.IsLoggedIn && UserState.UserId.HasValue)
        {
            var existingUser = UserService.GetById(UserState.UserId.Value);
            if (existingUser != null)
            {
                _shouldRedirect = true;
                return;
            }
            else
            {
                // User no longer exists - clear the stale state
                UserState.UserId = null;
                UserState.Username = null;
                UserState.DisplayName = null;
                UserState.SessionId = null;
            }
        }

        welcomeMessage = ChatConfig.GetRandomWelcomeMessage();
        joinButtonText = ChatConfig.GetRandomJoinButtonText();
        usernamePlaceholder = ChatConfig.GetRandomUsernamePlaceholder();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Safe to navigate after first render is complete
        if (_shouldRedirect)
        {
            NavigateToLobby();
            return;
        }

        // Check localStorage for stored token (requires JS interop, so must be in OnAfterRender)
        await TryAutoLoginAsync();
    }

    private async Task TryAutoLoginAsync()
    {
        try
        {
            // First try token-based auth (new system)
            var storedToken = await JS.InvokeAsync<string?>("getStoredToken");
            if (!string.IsNullOrWhiteSpace(storedToken))
            {
                var user = UserService.AuthenticateByToken(storedToken);
                if (user != null)
                {
                    // Token valid - populate user state and redirect
                    UserState.UserId = user.Id;
                    UserState.Username = user.Username;
                    UserState.DisplayName = user.DisplayName;
                    NavigateToLobby();
                    return;
                }
                else
                {
                    // Token invalid - clear it
                    await JS.InvokeVoidAsync("clearStoredToken");
                }
            }

            // Fall back to legacy login (username/sessionId) for migration
            var storedLoginJson = await JS.InvokeAsync<string?>("getStoredLogin");
            if (!string.IsNullOrWhiteSpace(storedLoginJson))
            {
                var jsonOptions = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                var storedLogin = System.Text.Json.JsonSerializer.Deserialize<StoredLogin>(storedLoginJson, jsonOptions);
                if (storedLogin != null && !string.IsNullOrWhiteSpace(storedLogin.Username))
                {
                    // Check if this username already has a User record
                    var existingUser = UserService.GetByUsername(storedLogin.Username);
                    if (existingUser != null)
                    {
                        // Username exists - user needs to create new account or we migrate them
                        // For now, clear storage and let them re-register
                        await JS.InvokeVoidAsync("clearStoredLogin");
                        usernameInput = storedLogin.Username;
                        hasError = true;
                        hasBlurred = true;
                        errorMessage = "Please re-enter your username to continue";
                        StateHasChanged();
                        return;
                    }

                    // Username doesn't exist in new system - auto-migrate by creating new user
                    if (!UserService.IsUsernameTaken(storedLogin.Username))
                    {
                        var newUser = await UserService.CreateUserAsync(storedLogin.Username);
                        if (newUser != null)
                        {
                            // Clear old storage and save new token
                            await JS.InvokeVoidAsync("clearStoredLogin");
                            await JS.InvokeVoidAsync("saveToken", newUser.Token);

                            // Populate user state
                            UserState.UserId = newUser.Id;
                            UserState.Username = newUser.Username;
                            UserState.DisplayName = newUser.DisplayName;
                            NavigateToLobby();
                            return;
                        }
                    }
                }
            }
        }
        catch (TaskCanceledException)
        {
            // Circuit disconnected - ignore
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Login] Auto-login failed: {ex.Message}");
        }
    }

    private void NavigateToLobby()
    {
        try
        {
            Navigation.NavigateTo("/lobby");
        }
        catch (TaskCanceledException)
        {
            // Circuit disconnected during navigation - ignore
        }
    }

    private record StoredLogin(string? Username, string? SessionId);

    private void ValidateUsername()
    {
        hasError = false;
        isLengthError = false;
        errorMessage = "";

        if (string.IsNullOrWhiteSpace(usernameInput))
            return;

        // Auto-trim and convert to lowercase
        var normalized = usernameInput.Trim().ToLowerInvariant();
        if (normalized != usernameInput)
        {
            usernameInput = normalized;
        }

        // Length check (2-32 characters)
        if (usernameInput.Length < 2)
        {
            hasError = true;
            isLengthError = true;
            errorMessage = "Username must be at least 2 characters";
            return;
        }

        // Character validation (a-z, 0-9, underscore, period only)
        if (!ValidUsernameRegex.IsMatch(usernameInput))
        {
            hasError = true;
            errorMessage = "Only lowercase letters, numbers, _ and . allowed";
            return;
        }

        // No consecutive periods
        if (usernameInput.Contains(".."))
        {
            hasError = true;
            errorMessage = "Cannot have consecutive periods";
            return;
        }

        // Username must be unique (check UserService, not ChatService)
        if (UserService.IsUsernameTaken(usernameInput))
        {
            hasError = true;
            errorMessage = "Username is already taken";
            return;
        }
    }

    private async Task HandleUsernameKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && IsValid) await JoinChat();
    }

    private void OnInputBlur()
    {
        hasBlurred = true;
    }

    private async Task JoinChat()
    {
        if (!IsValid) return;

        var username = usernameInput.Trim();

        // Create user with token
        var user = await UserService.CreateUserAsync(username);
        if (user == null)
        {
            hasError = true;
            errorMessage = "Failed to create user. Please try again.";
            StateHasChanged();
            return;
        }

        // Populate user state
        UserState.UserId = user.Id;
        UserState.Username = user.Username;
        UserState.DisplayName = user.DisplayName;

        // Save token to localStorage
        await JS.InvokeVoidAsync("saveToken", user.Token);

        try
        {
            Navigation.NavigateTo("/lobby");
        }
        catch (TaskCanceledException)
        {
            // Circuit disconnected during navigation - ignore
        }
    }
}

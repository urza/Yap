@namespace Yap.Components

@*  Reusable component that displays a user's profile picture or a colored circle with their initial  *@

<div class="avatar @SizeClass" style="@BackgroundStyle" title="@Username">
    @if (!string.IsNullOrEmpty(ProfilePictureUrl))
    {
        <img src="@ProfilePictureUrl" alt="@Username" class="avatar-image" />
    }
    else
    {
        <span class="avatar-initials">@Initial</span>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Username { get; set; } = "";
    [Parameter] public string? ProfilePictureUrl { get; set; }
    [Parameter] public AvatarSize Size { get; set; } = AvatarSize.Medium;

    private string SizeClass => Size switch
    {
        AvatarSize.Small => "avatar-small",
        AvatarSize.Medium => "avatar-medium",
        AvatarSize.Large => "avatar-large",
        _ => "avatar-medium"
    };

    private string Initial => string.IsNullOrEmpty(Username) ? "?" : Username[0].ToString().ToUpperInvariant();

    private string BackgroundStyle => string.IsNullOrEmpty(ProfilePictureUrl)
        ? GetGradientFromUsername(Username)
        : "";

    /// <summary>
    /// Curated gradient pairs — visually pleasing combos that look good behind white text.
    /// </summary>
    private static readonly (string From, string To)[] Gradients =
    [
        ("#667eea", "#764ba2"), // indigo → purple
        ("#f093fb", "#f5576c"), // pink → coral
        ("#4facfe", "#00f2fe"), // sky → cyan
        ("#43e97b", "#38f9d7"), // green → mint
        ("#fa709a", "#fee140"), // rose → gold
        ("#a18cd1", "#fbc2eb"), // lavender → blush
        ("#fccb90", "#d57eeb"), // peach → violet
        ("#e0c3fc", "#8ec5fc"), // lilac → blue
        ("#f6d365", "#fda085"), // sunshine → salmon
        ("#96fbc4", "#f9f586"), // mint → lemon
        ("#ff9a9e", "#fecfef"), // blush → pink
        ("#a1c4fd", "#c2e9fb"), // periwinkle → ice
        ("#d4fc79", "#96e6a1"), // lime → sage
        ("#84fab0", "#8fd3f4"), // aqua → sky
        ("#fbc2eb", "#a6c1ee"), // cotton candy → steel blue
        ("#ff6a88", "#ff99ac"), // strawberry → light pink
        ("#ffd89b", "#19547b"), // gold → deep teal
        ("#c471f5", "#fa71cd"), // purple → magenta
        ("#48c6ef", "#6f86d6"), // ocean → slate
        ("#feada6", "#f5efef"), // nude → snow
    ];

    private static string GetGradientFromUsername(string username)
    {
        if (string.IsNullOrEmpty(username))
            return "background: linear-gradient(135deg, #667eea, #764ba2);";

        var hash = 0;
        foreach (var c in username)
            hash = c + ((hash << 5) - hash);

        var index = (int)(((uint)hash) % Gradients.Length);
        var (from, to) = Gradients[index];
        return $"background: linear-gradient(135deg, {from}, {to});";
    }
}

@using Yap.Models

@if (Preview?.HasContent == true)
{
    <a href="@Preview.Url" target="_blank" rel="noopener noreferrer" class="link-preview-card">
        <div class="link-preview-content">
            @if (!string.IsNullOrEmpty(Preview.SiteName))
            {
                <span class="link-preview-site">@Preview.SiteName</span>
            }
            @if (!string.IsNullOrEmpty(Preview.Title))
            {
                <span class="link-preview-title">@Preview.Title</span>
            }
            @if (!string.IsNullOrEmpty(Preview.Description))
            {
                <span class="link-preview-description">@Preview.Description</span>
            }
        </div>
        @if (!string.IsNullOrEmpty(Preview.ImageUrl))
        {
            <div class="link-preview-thumbnail">
                <img src="@Preview.ImageUrl" alt="" loading="lazy" />
            </div>
        }
    </a>
}

@code {
    [Parameter, EditorRequired] public LinkPreview Preview { get; set; } = default!;
}

<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Yap.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Runtime data, not project files: the tus store and the uploads land here while the app runs.
         As project items they would be published into the image, and the IDE's file watcher treats a
         new file here as a changed asset of the running app. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);wwwroot\uploads\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Data\RequestLogs\" />
    <Folder Include="wwwroot\uploads\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.14">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- 3.1.12 carries two moderate advisories (NU1902) and no fixed release is adopted yet. The warning is off for
         this package only, so an advisory on any other package still shows. -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" NoWarn="NU1902" />
    <PackageReference Include="WebPush" Version="1.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
    <PackageReference Include="tusdotnet" Version="2.11.0" />
  </ItemGroup>

  <!-- Generate BuildInfo.g.cs with build timestamp -->
  <Target Name="GenerateBuildInfo" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <!-- UTC, with no space or colon: the stamp travels in URL queries (?v=) and in a cache name. -->
      <BuildTimestamp>$([System.DateTime]::UtcNow.ToString('yyyy-MM-dd-HHmm'))</BuildTimestamp>
      <BuildInfoContent>namespace Yap%3B public static class BuildInfo { public const string Time = "$(BuildTimestamp)"%3B }</BuildInfoContent>
    </PropertyGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)BuildInfo.g.cs" Lines="$(BuildInfoContent)" Overwrite="true" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)BuildInfo.g.cs" />
    </ItemGroup>
  </Target>

</Project>
